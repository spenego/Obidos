<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.7.0//EN"
        "http://gwtproject.org/doctype/2.7.0/gwt-module.dtd">
<module rename-to='Delegator'>
    <inherits name='com.google.gwt.user.User'/>
    <inherits name="com.google.gwt.json.JSON" />
    <inherits name="com.google.gwt.i18n.I18N"/>
    
    <inherits name='org.gwtbootstrap3.GwtBootstrap3'/>
    <inherits name="com.gwtplatform.mvp.MvpWithEntryPoint"/>
    
    <inherits name="com.googlecode.gwt.crypto.Crypto"/>  
    <inherits name="com.tractionsoftware.gwt.user.UTCDateTime"/>
    <inherits name="org.vectomatic.libgwtfile" />
    <inherits name='com.google.code.gwt.crop.GWTCropper'/>
    <inherits name='org.wisepersist.gwt.uploader.Uploader'/>

    <inherits name="com.spenego.Obidos.client.application.widgets.bootbox.Bootbox"/>
    <inherits name="com.spenego.Obidos.client.application.widgets.summernote.Summernote"/>
    
    <inherits name="org.gwtbootstrap3.extras.toggleswitch.ToggleSwitch"/>
    <inherits name="org.gwtbootstrap3.extras.select.Select"/>
    <inherits name="org.gwtbootstrap3.extras.datepicker.DatePicker"/>
    <inherits name="org.gwtbootstrap3.extras.datetimepicker.DateTimePicker"/>
    <inherits name="org.gwtbootstrap3.extras.notify.Notify"/>

    <extend-property name="locale" values="en,ar,bn,de,ml,hi,ja"/>
    <collapse-property name="locale" values="*" />
    <set-property name="user.agent" value="safari,gecko1_8" />
    <collapse-property name="user.agent" values="*" />
    <collapse-property name="formfactor" values="*" />


    <add-linker name="xsiframe"/>
    <set-configuration-property name="CssResource.enableGss" value="true"/>
    <set-configuration-property name="CssResource.conversionMode" value="strict" />
    <set-configuration-property name="gwtp.bootstrapper" value="com.spenego.Obidos.client.ObidosBootstrapper"/>
    
    <extend-configuration-property name="gin.ginjector.modules"
                                   value="com.spenego.Obidos.client.gin.ClientModule"/>

    <source path='client'/>
    <source path='shared'/>
    
    <set-property name="compiler.emulatedStack" value="true"/>
    <set-configuration-property name="compiler.emulatedStack.recordFileNames" value="true"/>
</module>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "mybatis-3-mapper.dtd">
<mapper namespace="com.spenego.Obidos.server.dao.AssignedContainerMapper">
	<resultMap id="BaseResultMap" type="com.spenego.Obidos.server.model.AssignedContainer">
		<result column="xxx"					jdbcType="BIGINT"		property="id" />
		<result column="container_id"			jdbcType="BIGINT"		property="containerId" />
		<result column="owner_id"				jdbcType="BIGINT"		property="ownerId" />
		<result column="zuser_id"				jdbcType="BIGINT"		property="userId" />
		<result column="name"					jdbcType="VARCHAR"		property="name" />
		<result column="owner_fullname"			jdbcType="VARCHAR"		property="ownerFullname" />
		<result column="email"					jdbcType="VARCHAR"		property="email" />
		<result column="phone"					jdbcType="VARCHAR"		property="phone" />
		<result column="is_private"				jdbcType="BIT"			property="isPrivate" />
		<result column="shared"					jdbcType="BIT"			property="shared" />
		<result column="view_flag"				jdbcType="BIT"			property="viewFlag" />
		<result column="share_flag"				jdbcType="BIT"			property="shareFlag" />
		<result column="modify_flag"			jdbcType="BIT"			property="modifyFlag" />
		<result column="created_at"				jdbcType="TIMESTAMP"	property="createdAt" />
		<result column="updated_at"				jdbcType="TIMESTAMP"	property="updatedAt" />
		<result column="shared_at"				jdbcType="TIMESTAMP"	property="sharedAt" />
		<result column="ownership_control"		jdbcType="BIT"			property="ownershipControl" />
		<result column="add_permitted"			jdbcType="BIT"			property="addPermitted" />
		<result column="update_permitted"		jdbcType="BIT"			property="updatePermitted" />
		<result column="version"				jdbcType="INTEGER"		property="version" />
		<result column="profile_pic_enabled"	jdbcType="BIT"			property="profilePictureEnabled" />
	</resultMap>

	<sql id="Example_Where_Clause">
		<where>
			<foreach collection="oredCriteria" item="criteria" separator="or">
				<if test="criteria.valid">
					<trim prefix="(" prefixOverrides="and" suffix=")">
						<foreach collection="criteria.criteria" item="criterion">
							<choose>
								<when test="criterion.noValue">
									and ${criterion.condition}
								</when>
								<when test="criterion.singleValue">
									and ${criterion.condition} #{criterion.value}
								</when>
								<when test="criterion.betweenValue">
									and ${criterion.condition} #{criterion.value} and #{criterion.secondValue}
								</when>
								<when test="criterion.listValue">
									and ${criterion.condition}
								<foreach close=")" collection="criterion.value" item="listItem" open="(" separator=",">
									#{listItem}
								</foreach>
								</when>
							</choose>
						</foreach>
					</trim>
				</if>
			</foreach>
		</where>
	</sql>

	<sql id="Base_Column_List">
		ca.id as xxx, c.name as name, c.id as container_id, u.fullname as owner_fullname, u.email1 as email, u.phone as phone,
		c.is_private as is_private, c.user_id as owner_id, ca.user_id as zuser_id, ca.view_flag, ca.share_flag, ca.modify_flag,
		c.shared as shared, c.created_at as created_at, c.updated_at as updated_at, c.version as version,
		ca.ownership_control as ownership_control, ca.add_permitted as add_permitted, ca.update_permitted as update_permitted,
		ca.created_at as shared_at, u.preference_flags &amp; 0x4 as profile_pic_enabled
	</sql>

	<select id="selectByExample" parameterType="com.spenego.Obidos.server.model.AssignedContainerExample" resultMap="BaseResultMap">
		select
		<if test="distinct">
			distinct
		</if>
		<include refid="Base_Column_List" />
			from containers c
				join container_assignments ca ON ca.container_id = c.id
				join users u ON c.user_id = u.id
		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>
		<if test="orderByClause != null">
			order by ${orderByClause}
		</if>
	</select>

<select id="countByExample" parameterType="com.spenego.Obidos.server.model.AssignedContainerExample" resultType="java.lang.Integer">
		select count(
		<if test="distinct">
			distinct
		</if>
		c.id) from containers c
			join container_assignments ca ON ca.container_id = c.id
		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>
	</select>
</mapper>

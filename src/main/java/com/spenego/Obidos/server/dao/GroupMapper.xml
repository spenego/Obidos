				</if>
			</foreach>
		</where>
	</sql>

	<sql id="Base_Column_List">g.id, g.user_id, g.name, g.version, g.minimum_security_clearance, g.global, g.created_at, g.updated_at, g.comments</sql>
	<sql id="Permission_Column_List"> <include refid="Base_Column_List" />, update_permitted, ownership_control</sql>

	<select id="selectByExample" parameterType="com.spenego.Obidos.server.model.GroupExample" resultMap="BaseResultMap">
		select
		<if test="distinct">distinct</if>
		<include refid="Base_Column_List" />
		from groups g
		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>
		<if test="orderByClause != null">
			order by ${orderByClause}
		</if>
	</select>

	<select id="selectItemGroupsByExample" parameterType="com.spenego.Obidos.server.model.GroupExample" resultMap="BaseResultMap">
		select
		<if test="distinct">distinct</if>
		<include refid="Permission_Column_List" />
		from groups g
			join item_groups ig on ig.group_id = g.id
		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>
		<if test="orderByClause != null">

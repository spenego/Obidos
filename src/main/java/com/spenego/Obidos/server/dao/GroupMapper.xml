		</if>
	</select>

	<select id="selectItemGroupIdsByExample" parameterType="com.spenego.Obidos.server.model.GroupExample" resultMap="BaseResultMap">
		select distinct g.id from groups g
			join item_groups ig on ig.group_id = g.id
		<if test="_parameter != null">

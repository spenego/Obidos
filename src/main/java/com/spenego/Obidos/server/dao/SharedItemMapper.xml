<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "mybatis-3-mapper.dtd">
<mapper namespace="com.spenego.Obidos.server.dao.SharedItemMapper">
	<resultMap id="BaseResultMap" type="com.spenego.Obidos.server.model.SharedItem">
		<result column="id"							jdbcType="BIGINT"		property="id" />
		<result column="item_id"					jdbcType="BIGINT"		property="itemId" />
		<result column="container_assignment_id"	jdbcType="BIGINT"		property="containerAssignmentId" />
		<result column="owner_id"					jdbcType="BIGINT"		property="ownerId" />
		<result column="shared"						jdbcType="BIT"			property="shared" />
		<result column="security_classification"	jdbcType="INTEGER"		property="securityClassification" />
		<result column="shareable"					jdbcType="BIT"			property="shareable" />
		<result column="is_container_private"		jdbcType="BIT"			property="isContainerPrivate" />
    	<result column="name"						jdbcType="VARCHAR"		property="name" />
		<result column="container_name"				jdbcType="VARCHAR"		property="containerName" />
		<result column="created_at"					jdbcType="TIMESTAMP"	property="createdAt" />
		<result column="updated_at"					jdbcType="TIMESTAMP"	property="updatedAt" />
		<result column="shared_at"					jdbcType="TIMESTAMP"	property="sharedAt" />
		<result column="shares_expire_at"			jdbcType="TIMESTAMP"	property="sharesExpireAt" />
		<result column="zuser_id"					jdbcType="BIGINT"		property="userId" />
		<result column="owner_fullname"				jdbcType="VARCHAR"		property="ownerFullname" />
		<result column="username"					jdbcType="VARCHAR"		property="username" />
		<result column="email"						jdbcType="VARCHAR"		property="email" />
		<result column="phone"						jdbcType="VARCHAR"		property="phone" />
		<result column="version"					jdbcType="INTEGER"		property="version" />
		<result column="shared_explicitly"			jdbcType="BIT"			property="sharedExplicitly" />
		<result column="update_permitted"			jdbcType="BIT"			property="updatePermitted" />
		<result column="ownership_control"			jdbcType="BIT"			property="ownershipControl" />
		<result column="profile_pic_enabled"		jdbcType="BIT"			property="profilePictureEnabled" />
	</resultMap>

	<sql id="Example_Where_Clause">
		<where>
			<foreach collection="oredCriteria" item="criteria" separator="or">
				<if test="criteria.valid">
					<trim prefix="(" prefixOverrides="and" suffix=")">
						<foreach collection="criteria.criteria" item="criterion">
							<choose>
								<when test="criterion.noValue">
									and ${criterion.condition}
								</when>
								<when test="criterion.singleValue">
									and ${criterion.condition} #{criterion.value}
								</when>
								<when test="criterion.betweenValue">
									and ${criterion.condition} #{criterion.value} and #{criterion.secondValue}
								</when>
								<when test="criterion.interiorOr">
									and ( ${criterion.condition} #{criterion.value} or ${criterion.secondCondition} )
								</when>
								<when test="criterion.listValue">
									and ${criterion.condition}
									<foreach close=")" collection="criterion.value" item="listItem" open="(" separator=",">
										#{listItem}
									</foreach>
								</when>
							</choose>
						</foreach>
					</trim>
				</if>
			</foreach>
		</where>
	</sql>

	<sql id="Base_Column_List">
		i.id as item_id, i.user_id as owner_id, i.name as name, i.container_assignment_id as container_assignment_id,
		i.shared as shared, i.created_at as created_at, i.updated_at as updated_at, i.security_classification as security_classification,
		i.shareable as shareable, i.version as version, shares_expire_at, u.fullname as owner_fullname,
		ia.shared_explicitly as shared_explicitly
	</sql>

	<sql id="Permissions_Column_List">
		ia.update_permitted as update_permitted, ia.ownership_control as ownership_control
	</sql>

	<sql id="Assigned_Items_Column_List">
		c.name as container_name, ia.id as id, ia.user_id as zuser_id, ia.created_at as shared_at,
	   	u.preference_flags &amp; 0x4 as profile_pic_enabled
	</sql>

	<sql id="Group_Items_Column_List">
		i.id as id, i.user_id as zuser_id
	</sql>

	<sql id="Shared_Items_Details_Column_List">
		<include refid="Base_Column_List" />,
		c.name as container_name, c.is_private as is_container_private,
		u.username as username, u.email1 as email, u.phone as phone,
	   	u.preference_flags &amp; 0x4 as profile_pic_enabled
	</sql>

	<select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
		select distinct
		<include refid="Shared_Items_Details_Column_List" />
		from items i
			join users u on u.id = i.user_id
			join container_assignments ca on ca.id = i.container_assignment_id
			join containers c on c.id = ca.container_id
			join item_assignments ia on ia.item_id = i.id
		where i.id = #{id,jdbcType=BIGINT}
	</select>

	<select id="selectByExample" parameterType="com.spenego.Obidos.server.model.SharedItemExample" resultMap="BaseResultMap">
		select
		<if test="distinct">
			distinct
		</if>
		<include refid="Base_Column_List" />,
		<include refid="Permissions_Column_List" />,
		<include refid="Assigned_Items_Column_List" />,
		<include refid="Shared_Items_Details_Column_List" />

		from items i
			join users u on u.id = i.user_id
			join container_assignments ca on ca.id = i.container_assignment_id
			join containers c on c.id = ca.container_id
			join item_assignments ia on ia.item_id = i.id

		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>

		<if test="orderByClause != null">
			order by ${orderByClause}
		</if>
	</select>

	<select id="selectTerseByExample" parameterType="com.spenego.Obidos.server.model.SharedItemExample" resultMap="BaseResultMap">
		select distinct i.id as id, i.name as name, i.container_assignment_id as container_assignment_id
		from items i join container_assignments ca on ca.id = i.container_assignment_id

		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>

		<if test="orderByClause != null">
			order by ${orderByClause}
		</if>
	</select>

	<select id="selectByGroupExample" parameterType="com.spenego.Obidos.server.model.SharedItemExample" resultMap="BaseResultMap">
		select
		<if test="distinct">
			distinct
		</if>
		<include refid="Base_Column_List" />,
		<include refid="Group_Items_Column_List" />

		from items i
			join item_assignments ia on ia.item_id = i.id
			join users u on u.id = i.user_id
			join item_groups ig on ig.item_id = i.id

		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>

		<if test="orderByClause != null">
			order by ${orderByClause}
		</if>
	</select>

	<select id="countByExample" parameterType="com.spenego.Obidos.server.model.SharedItemExample" resultType="java.lang.Integer">
		select count(*) from items i
			join item_assignments ia on ia.item_id = i.id
			join container_assignments ca on ca.id = i.container_assignment_id
		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>
	</select>
	<select id="countByGroupExample" parameterType="com.spenego.Obidos.server.model.SharedItemExample" resultType="java.lang.Integer">
		select count(*) from items i
			join item_assignments ia on ia.item_id = i.id
			join item_groups ig on ig.item_id = i.id
		<if test="_parameter != null">
			<include refid="Example_Where_Clause" />
		</if>
	</select>
</mapper>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<!-- Trip long texts with ellipsis Ref: http://grokbase.com/t/gg/google-web-toolkit/124xczgwye/how-to-build-text-trimming-cell-for-gwt-datagrid 
		Ref: http://stackoverflow.com/questions/17779293/css-text-overflow-ellipsis-not-working/17783233#17783233 
		Note: at one point the CSS was .datagrid-cell and Chrome, Firefox was crashing 
		with exception in style. After I changed it to .myDataGridCell, everything 
		seems to work fine. Need to do some investigation... (Apr-27-2017) -->

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
<ui:style gss="true">
	.myDataGridCell td div {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.redBackground {
		background-color: #ff0000;
	}
	
	.message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.list-users-panel-header {
		background-color: #222 !important;
	}
	
	.h-paragraph-font {
		font-size: 13px;
	}
	
	.item-ginfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	.form-error-label{
		color: red;
	}
	.left-margin-x {
		padding: 15px;
		margin-left: 5px;
	}
	.left-margin {
		padding: 0px;
		margin-left: 15px;
	}

	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	.sort-style {
		font-weight: bold;
	}
</ui:style>

	<!-- Unfortunately we can not use DockLayout, because it requires the parent 
		to use RootLayoutPanel and I can not make gwtp do that at this time. If fire 
		RootLaoutPanelEvent from the presenter it works but it takes over the entire 
		screen and Navbar disappears! -->

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
				<b:BlockQuote addStyleNames="{style.item-ginfo}" ui:field='helpBlockQuote' visible="false">
					<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.h-paragraph-font}' HTML="{i18n.listUsersHelp}"/>
				</b:BlockQuote>
					<b:Panel type="PRIMARY">
					    <m:ObidosPanelHeader addStyleNames="{style.list-users-panel-header}" ui:field="panelHeader" showBackButton="false" headerText="{i18n.activeUsers}"/>
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">
								<b:Row>
								    <m:ObidosButtonToolBar ui:field="buttonToolBar">
										<b:Button type="DANGER" ui:field='deleteButton' block="false" text="{i18n.markAsDeleted}"/>
										<b:Button type="WARNING" ui:field='lockButton'  block="false" text="{i18n.markAsLocked}"/>
									</m:ObidosButtonToolBar>
								</b:Row>

								<m:ObidosMessageRow ui:field="messageRow"/>

										<b:Row>
											<b:FormLabel addStyleNames="col-sm-4" ui:field='searchLabel' text="{i18n.searchUsers}"/>
											<g:FlowPanel addStyleNames="col-sm-4">
												<b:InputGroup>
													<m:ObidosTextBox ui:field='searchTextBox' placeholder="{i18n.searchUsers}"/>
													<b:InputGroupButton>
														<b:Button ui:field="searchButton" type="PRIMARY" icon="SEARCH" />
													</b:InputGroupButton>
												</b:InputGroup>
											</g:FlowPanel>
										</b:Row>
									<b:Row ui:field="selectCheckBoxRow">
										<g:FlowPanel addStyleNames="{style.left-margin}">
											<m:ObidosCheckBoxButton ui:field="selectCheckBoxButton"/>
											<b:ButtonGroup>
												<b:Button type="LINK" icon="SORT" addStyleNames="{style.sort-style}" dataToggle="DROPDOWN" toggleCaret="false" text="{i18n.sort}" />
												<b:DropDownMenu>
													<b:AnchorListItem ui:field="sortByDate" text="{i18n.sortByUpdatedDate}" />
													<b:AnchorListItem icon="SORT_ALPHA_ASC" ui:field="sortByAZ" text="{i18n.sortByAlphabetAZ}" />
													<b:AnchorListItem icon="SORT_ALPHA_DESC" ui:field="sortByZA" text="{i18n.sortByAlphabetZA}" />
												</b:DropDownMenu>
											</b:ButtonGroup>
										</g:FlowPanel>
									</b:Row>

								</b:Form>
								<b.gwt:DataGrid bordered="true" addStyleNames='{style.myDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
								<table style="width:100%">
									<tr>
										<td align='center'>
											<c:SimplePager ui:field='pager' />
										</td>
									</tr>
								</table>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

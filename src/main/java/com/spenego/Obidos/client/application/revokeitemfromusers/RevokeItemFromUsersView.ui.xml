<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:c="urn:import:com.google.gwt.user.cellview.client"
             xmlns:summer="urn:import:com.spenego.Obidos.client.application.widgets.summernote"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<!--  https://isabelcastillo.com/error-info-messages-css -->
<ui:style gss="true">
.share-note-message-error{
    margin: 10px 0px;
    padding:12px;
    color: #D8000C;
    background-color: #FFBABA;
    box-shadow:1px 1px 3px #888;
}
.share-note-message-info{
    margin: 10px 0px;
    padding:12px;
    color: #00529B;
    background-color: #BDE5F8;
    box-shadow:1px 1px 3px #888;
}
.form-error-label{
    color: red;
}
.margin-fix {
    margin-top: 0 !important;
}
.margin {
    margin: 5px;
}
.itemUsersDataGridCell td div{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.help-bq {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.help-paragraph-font {
    font-size: 13px;    
}
.center-toolbar {
	justify-content: center;
	display: flex;
}
.bottom-margin {
	margin-bottom: 3px;
}
.bottom-margin2 {
	margin-bottom: 10px;
}
.ro-font {
	color: black;
	font-weight: bold;
}
.button-margin {
	margin-left: 5px;
}
</ui:style>

<!--
*********************************************************************
This is the UI for revoking Note/Item from Users
*********************************************************************
-->

<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
	   <b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="{i18n.revokeItemFromUsersHelp}" />
  	    </b:BlockQuote>

		<b:Row>
				<b:Panel type="PRIMARY">
                     <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.revokeItem}"/>
					<b:PanelBody>
						<b:Form type="HORIZONTAL">
							<m:ObidosRow bottomMargin="2px" ui:field="containerRow">
								<b:FormLabel ui:field='containerNameLabel' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}"/>
								<g:FlowPanel addStyleNames="col-sm-4">
								    <m:ObidosInputGroup ui:field="containerNameInputGroup" readOnly="true" isSecure="false" placeHolder=""/>
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel ui:field='itemNameLabel' addStyleNames="col-sm-4" text="{i18n.item}"/>
								<g:FlowPanel addStyleNames="col-sm-4">
    							    <m:ObidosInputGroup ui:field="itemNameInputGroup" readOnly="true" isSecure="false" placeHolder=""/>
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel ui:field='commentLabel' addStyleNames="col-sm-4" text="{i18n.commentLabel}"/>
								<g:FlowPanel addStyleNames="col-sm-4">
									<m:ObidosTextBox ui:field="revokeCommentTextBox" placeholder="{i18n.revokeContainerPlaceHolder}"/>
								</g:FlowPanel>
							</m:ObidosRow>
							
							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4">Search</b:FormLabel>
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup>
										<m:ObidosTextBox ui:field="searchTextBox" placeholder='{i18n.searchUsers}' enabled="true"/>
										<b:InputGroupButton>
											<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text=""/>
										</b:InputGroupButton>
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>

                            <!-- issue 659 -->
							<m:ObidosRow bottomMargin="{i18n.bottomMargin}" visible="false">
								<b:FormLabel addStyleNames="col-sm-4" text="{i18n.sendNotificationEmail}"/>
								<g:FlowPanel addStyleNames="col-sm-4">
									  <b3:ToggleSwitch ui:field="sendNotificationEmailSwitch" size="SMALL" onColor="SUCCESS" offColor="DANGER" onText="✓" offText="✗" value="false"/>
								  </g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosMessageRow ui:field="messageRow"/>

							<b:Row>
								<m:ObidosClearSelectionsButton ui:field="clearButton"/>
								<m:ObidosRevokeButton ui:field="revokeButton"/>
							</b:Row>
						</b:Form>

						<g:HTMLPanel>
							<b.gwt:DataGrid bordered="true" addStyleNames='{style.itemUsersDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid"/>
							<g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
								  <tr>
									<td align='center'>
									  <c:SimplePager ui:field='pager' />
									</td>
								  </tr>
								</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
				    </b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

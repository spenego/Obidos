<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:summer="urn:import:com.spenego.Obidos.client.application.widgets.summernote"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:select="urn:import:org.gwtbootstrap3.extras.select.client.ui"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
<!-- https://isabelcastillo.com/error-info-messages-css -->
<ui:style gss="true">
.grant-message-error {
	margin: 10px 0px;
	padding: 12px;
	color: #D8000C;
	background-color: #FFBABA;
	box-shadow: 1px 1px 3px #888;
}
.grant-message-info { margin: 10px 0px;
	padding: 12px;
	color: #00529B;
	background-color: #BDE5F8;
	box-shadow: 1px 1px 3px #888;
}
.form-error-label {
	color: red;
}
.help-bq {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.help-paragraph-font {
    font-size: 13px;    
}
.margin-fix {
	margin-top: 0 !important;
}
.margin {
	margin: 5px;
}
.permUsersDataGridCell td div {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.center-toolbar {
	justify-content: center;
	display: flex;
}

.move-left {
	text-align: left;
}
.grant-button {
	font-weight: bold !important;
	padding: 1px 1px 1px 15px;
	color: green;
}
.ro-font{
	color:black;
	font-weight: bold;
}
</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
		<b:Row>
		   <b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="{i18n.grantPermissionOnContainerHelp}" />
			</b:BlockQuote>

					<b:Panel type="PRIMARY">
                        <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.grantPermissionOnContainer}" />
						<b:PanelBody>
							<b:Form type="HORIZONTAL">
								<b:Row ui:field="containerRow">
								    <m:ObidosRowBottom2px>
										<b:FormLabel ui:field='containerNameLabel' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
										<g:FlowPanel addStyleNames="col-sm-4">
        									<m:ObidosInputGroup ui:field="containerNameInputGroup" readOnly="true" isSecure="false" placeHolder=""/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<b:Row visible='false'>
										<b:FormLabel ui:field='containerTypeLabel' addStyleNames="col-sm-4" text="{i18n.containerTypeLabel}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup ui:field='containerTypeInputGroup'>
												<b:InputGroupAddon icon="UNLOCK" iconColor="red" iconPosition="RIGHT" />
												<m:ObidosTextBox ui:field="containerTypeTextBox" readOnly="true" />
											</b:InputGroup>
										</g:FlowPanel>
									</b:Row>
								</b:Row>

								<!--  don't delete -->
								<!-- 
									<b:Row>
										<b:FormLabel for="forPermissionabel" ui:field='permissionsLabel' addStyleNames="col-sm-4" text="{i18n.permissions}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<select:MultipleSelect ui:field='selectPermissions' b:id="permissions" enabled="true">
												<select:Option text="{i18n.mayUpdate}" />
												<select:Option text="{i18n.mayDelete}" />
												<select:Option text="{i18n.mayTakeOwnershipControl}" />
											</select:MultipleSelect>
										</g:FlowPanel>
									</b:Row>
									-->
									
									<m:ObidosRowBottom2px>
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.permissions}" />
    									<g:FlowPanel addStyleNames="col-sm-8">
											  <b:InlineCheckBox ui:field="readCheckBox" text="{i18n.read}" value="true" enabled="false"/>
											  <b:InlineCheckBox ui:field="mayUpdateCheckBox" text="{i18n.add}" visible="false"/>
											  <b:InlineCheckBox ui:field="mayTakeOwnershipCheckBox" text="{i18n.mayUpdateOwn}" visible="false"/>
											  <b:InlineCheckBox ui:field="addCheckBox" text="{i18n.add}"/>
											  <b:InlineCheckBox ui:field="updateCheckBox" text="{i18n.edit}"/>
											  <b:InlineCheckBox ui:field="ownCheckBox" text="{i18n.own}"/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									
									<m:ObidosRow bottomMargin="{i18n.bottomMargin}">
											<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4">Search</b:FormLabel>
											<g:FlowPanel addStyleNames="col-sm-4">
												<b:InputGroup>
													<m:ObidosTextBox ui:field="searchTextBox" placeholder='{i18n.searchUsers}' enabled="true" />
													<b:InputGroupButton>
														<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text="" />
													</b:InputGroupButton>
												</b:InputGroup>
											</g:FlowPanel>
									</m:ObidosRow>

        							<m:ObidosMessageRow ui:field="messageRow"/>

									<b:Row>
										<m:ObidosClearSelectionsButton ui:field="clearButton" visible="false"/>
		      							<b:Button ui:field="grantButton" type="LINK" icon="CHECK_CIRCLE" title="{i18n.selectToGrantPermissions}" addStyleNames="{style.grant-button}" text="{i18n.grant}"/>
									</b:Row>
							</b:Form>

							<g:HTMLPanel>
								<b.gwt:DataGrid bordered="true" addStyleNames='{style.permUsersDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
								<g:HTMLPanel ui:field="htmlPanel2">
									<table style="width:100%">
										<tr>
											<td align='center'>
												<c:SimplePager ui:field='pager' />
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />

	<ui:style gss="true">
	.resetp-req-form-title {
		color: #666;
		font-size: 18px;
		font-weight: 400;
		display: block;
	}
	
	.form-error-label {
		color: red;
	}
	
	.resetreq-danger {
		background-color: #fcf2f2;
		border-color: #dFb5b4;
	}
	
	.margin {
		margin: 5px;
	}
	
	.top-margin {
		margin-top: 20px;
	}
	</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container>
			<b:Row>
				<b:Column size="XS_12">
					<b:Panel ui:field='resetReqPanel' type="PRIMARY"
						addStyleNames="{style.top-margin}">
						<m:ObidosPanelHeader ui:field="panelHeader"
							showBackButton="false" headerText="{i18n.resetPasswordPanelHeading}" />
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">
									<b:Form type="HORIZONTAL">
									   <b:Row>
										<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
										  <b:ListGroup>
										      <b:ListGroupItem HTML="{i18n.forgotLoginNameText}"/>
										      <b:ListGroupItem HTML="{i18n.forgotPasswordText}"/>
										  </b:ListGroup>
										</g:FlowPanel>
									   </b:Row>
									</b:Form>

									<b:FormGroup ui:field='resetReqEmailFormGroup'>
										<m:ObidosRow bottomMargin="4px">
											<b:FormLabel for="forUsername" ui:field='usernameLabel' addStyleNames="col-sm-4" text="{i18n.loginName}"/>
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="usernameTextBox" placeholder="{i18n.loginName}" allowBlank="false" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosMessageRow ui:field="messageRow" />

										<m:ObidosButtonToolBar ui:field="buttonToolBar">
											<b:Button type="SUCCESS" ui:field='sendEmailButton' block="false"
												text="{i18n.sendResetPasswordInstructions}" />
											<b:Button type="DANGER" ui:field='cancelButton' block="false"
												text="{i18n.cancel}" />
										</m:ObidosButtonToolBar>

									</b:FormGroup>
								</b:Form>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
				</b:Column>
			</b:Row>
			<!-- <b:BlockQuote ui:field='resetReqwarningBlock' addStyleNames="{style.resetreq-danger}"> 
				<b:Heading size="H4" text="{i18n.resetPasswordHeading}"/> <b.html:Paragraph ui:field='resetReqWarningParagraph' 
				HTML="{i18n.resetPasswordWarning}"/> </b:BlockQuote> -->
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

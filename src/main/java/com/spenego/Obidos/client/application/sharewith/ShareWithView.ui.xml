<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:c="urn:import:com.google.gwt.user.cellview.client"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.form-error-label{
    color: red;
}
.xff-item-ginfo {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.xff-item-paragraph-font {
    font-size: 13px;    
}

.center-toolbar {
	justify-content: center;
	display: flex;
}

.doublespacer {
	margin:0; 
	padding:0; 
	height:2em; 
}

.left-pad {
	padding-left: 15px !important; 
}

</ui:style>

<!--
*****************************************************************************
This is the UI for selecting whether to share Note/Item with Users or Groups
*****************************************************************************
-->

<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
 	    <b:BlockQuote addStyleNames="{style.xff-item-ginfo}" ui:field='helpBlockQuote' visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.xff-item-paragraph-font}' HTML="{i18n.sharewithHelp}" />
		</b:BlockQuote>
		<b:Row>
				<b:Panel type="PRIMARY">
                    <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.share}" />
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">

    								<b:Row>
									<b.html:Br />
    								</b:Row>
								<m:ObidosRow bottomMargin="2px" ui:field="containerNameRow">
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.containerName}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosInputGroup ui:field="containerNameInputGroup" readOnly="true" isSecure="false" placeHolder=""/>
										</g:FlowPanel>
								</m:ObidosRow>
								<m:ObidosRow bottomMargin="2px">
										<b:FormLabel ui:field='nameLabel' addStyleNames="col-sm-4" text="{i18n.itemNameLabel}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosInputGroup ui:field="nameInputGroup" readOnly="true" isSecure="false" placeHolder=""/>
										</g:FlowPanel>
								</m:ObidosRow>

								<m:ObidosMessageRow ui:field="messageRow"/>

    							<b:Row>
									<m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
										<b:Button type="SUCCESS" ui:field='shareWithUsersButton' icon="ARROW_RIGHT" iconPosition="RIGHT" text="{i18n.shareWithUsers}"/>
										<b:Button type="SUCCESS" ui:field='shareWithGroupButton' icon="ARROW_RIGHT" iconPosition="RIGHT" text="{i18n.shareWithGroups}"/>
									</m:ObidosButtonToolBar>
								</b:Row>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
		</b:Row>
		
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

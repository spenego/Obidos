<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:c="urn:import:com.google.gwt.user.cellview.client"
             xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
	     xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>

<ui:style gss="true">
.searchDataGridCell td div {
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.redBackground {
    background-color: #ff0000;
}
.form-error-label{
    color: red;
}
.item-ginfo {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.message-info{
    margin: 10px 0px;
    padding:12px;
    color: #00529B;
    background-color: #BDE5F8;
    box-shadow:1px 1px 3px #888;
}
.list-users-panel-header{
    background-color:#222222 !important;
}
.margin-fix {
    margin-top: 0 !important;
}
.item-paragraph-font {
    font-size: 13px;    
}
.label-margin {
	margin-left: 15px;
}
</ui:style>

<g:HTMLPanel ui:field="htmlTopPanel">
    <b:Container addStyleNames="col-sm-12">
	   <b:BlockQuote addStyleNames="{style.item-ginfo}" ui:field='helpBlockQuote' visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.item-paragraph-font}' text="TODO"/>
		</b:BlockQuote>

		<b:Row>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.searchUsers}"/>
					<b:PanelBody>
						<g:HTMLPanel>

							<b:Form type="HORIZONTAL">
        						    <m:ObidosRowBottom2px>
										<b:FormLabel for="forLoginName" addStyleNames="col-sm-4" text="{i18n.username}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="userNameTextBox" placeholder="{i18n.searchByUsername}"/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

        						    <m:ObidosRowBottom2px>
										<b:FormLabel for="forFullname" addStyleNames="col-sm-4" text="{i18n.fullname}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="fullNameTextBox" placeholder="{i18n.searchByFullname}"/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

        						    <m:ObidosRowBottom2px>
										<b:FormLabel for="forFullname" addStyleNames="col-sm-4" text="{i18n.primaryEmail}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="emailTextBox" placeholder="{i18n.searchByPrimaryEmail}"/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									
        						    <b:Row visible="false"> <!--  creates trouble with search as users and admins gets mixed -->
										<b:FormLabel ui:field="twoFAPasswordResetLabel" addStyleNames="col-sm-4" text="{i18n.administrator}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											 <b3:ToggleSwitch ui:field='adminSwitch' size="SMALL" onText="Yes" offText="No" value="false"/>
										</g:FlowPanel>
									</b:Row>

        						    <m:ObidosRowBottom2px>
										<b:FormLabel ui:field="twoFALoignLabel" addStyleNames="col-sm-4" text="{i18n.lockedUser}"/>
										<g:FlowPanel addStyleNames="col-sm-1">
											 <b3:ToggleSwitch ui:field='lockedUserSwitch' onColor="SUCCESS" offColor="DANGER" size="SMALL" onText="✓" offText="✗" value="false"/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

        						    <m:ObidosRowBottom2px>
										<b:FormLabel ui:field="canCreateGlobalTemplateLabel" addStyleNames="col-sm-4" text="{i18n.tombStoned}"/>
										<g:FlowPanel addStyleNames="col-sm-1">
											 <b3:ToggleSwitch ui:field='deletedUserSwitch' onColor="SUCCESS" offColor="DANGER" size="SMALL" onText="✓" offText="✗" value="false"/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

    								<m:ObidosMessageRow ui:field="messageRow"/>

        						    <m:ObidosRowBottom2px>
								        <m:ObidosButtonToolBar ui:field="bottomToolBar">
											 <b:Button type="PRIMARY" ui:field='searchButton' text="{i18n.searchButtonTitle}"/>
										 </m:ObidosButtonToolBar>
									 </m:ObidosRowBottom2px>
								<b:Row>
								    <b:FormLabel ui:field="searchFilterLabel" addStyleNames="{style.label-margin}" text="{i18n.activeUsers}"/>
								</b:Row>
							</b:Form>

								 <b.gwt:DataGrid bordered="true" addStyleNames='{style.searchDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid"/>
								  <g:HTMLPanel ui:field="htmlPanel">
									<table style="width:100%">
									  <tr>
										<td align='center'>
										  <c:SimplePager ui:field='pager' />
										</td>
									  </tr>
									</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.encrypted-info {
		color: #9900ff;
	}
	
	.message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.margin {
		margin: 5px;
	}
	
	.listUsersDataGridCell td div {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.cont-help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.cont-help-paragraph-font {
		font-size: 13px;
	}
	
	.bottom-margin {
		margin-bottom: 3px;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	</ui:style>

	<!-- ********************************************************************* This is the UI 
		for listing the users to whom a Container was shared. ********************************************************************* -->

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:BlockQuote addStyleNames="{style.cont-help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.cont-help-paragraph-font}' HTML="TODO" />
			</b:BlockQuote>

			<b:Row>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true"
						headerText="{i18n.listOfUsersContainerIsSharedWith}" />
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">
								<m:ObidosRowBottom2px>
									<b:FormLabel for="forContainerName" ui:field='containerNameLabel'
										addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<m:ObidosInputGroup ui:field="containerNameInputGroup"
											readOnly="true" isSecure="false" placeHolder="" />
									</g:FlowPanel>
								</m:ObidosRowBottom2px>

								<b:Row>
									<b:FormLabel for="forSearchLabel" ui:field='searchLabel'
										addStyleNames="col-sm-4" text="{i18n.search}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<b:InputGroup>
											<m:ObidosTextBox ui:field="searchTextBox"
												placeholder='{i18n.searchUsersPlaceHolder}' enabled="true" />
											<b:InputGroupButton>
												<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text="" />
											</b:InputGroupButton>
										</b:InputGroup>
									</g:FlowPanel>
								</b:Row>
								<m:ObidosMessageRow ui:field="messageRow" />
							</b:Form>

							<b.gwt:DataGrid bordered="true"
								addStyleNames='{style.listUsersDataGridCell}' condensed="true" striped="true"
								hover="true" width="100%" ui:field="dataGrid" />
							<g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
									<tr>
										<td align='center'>
											<c:SimplePager ui:field='pager' />
										</td>
									</tr>
								</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.centered {
		margin: auto;
		max-width: 600px;
	}
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.whatIsIt}" />
					<b:PanelBody>
						<b:Row addStyleNames="{style.centered}">
							<g:HTMLPanel>
								<g:HTML ui:field='infoHtml' />
								<g:HTML ui:field='buildHtml' />
							   <b:Heading size="H4">
							     <b.html:Text text="Documents"/>
  						       </b:Heading>
							     <b:ListGroup>
							         <b:ListGroupItem ui:field='userGuideLGI'>
							             <b:Button ui:field='userGuideButton' text="{i18n.userGuide}" icon='FILE_PDF_O' type="LINK"/>
							         </b:ListGroupItem>
							         <b:ListGroupItem ui:field='adminGuideLGI'>
							             <b:Button ui:field='adminGuideButton' text="{i18n.adminGuide}" icon='FILE_PDF_O' type="LINK"/>
							         </b:ListGroupItem>
							         <!-- Issue 41, hide ChangeLog  -->
							         <b:ListGroupItem ui:field='changeLog' visible="false">
							             <b:Button ui:field='changeLogButton' text="{i18n.changeLog}" icon='FILE_TEXT' type="LINK"/>
							         </b:ListGroupItem>

							     </b:ListGroup>
							</g:HTMLPanel>
                            <b:Form>
								<!-- invisible FormPanel for Download POST request -->
								<g:FormPanel ui:field='formPanel' visible='false'/>
							</b:Form>
						</b:Row>
					    <m:ObidosMessageRow ui:field="messageRow"/>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>
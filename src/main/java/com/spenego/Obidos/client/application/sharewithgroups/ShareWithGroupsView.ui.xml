<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:c="urn:import:com.google.gwt.user.cellview.client"
             xmlns:summer="urn:import:com.spenego.Obidos.client.application.widgets.summernote"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.form-error-label{
    color: red;
}
.itemShareGroupDataGridCell td div{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.message-info-note{
    margin: 10px 0px;
    padding:12px;
    color: #00529B;
    background-color: #BDE5F8;
    box-shadow:1px 1px 3px #888;
}
.margin-fix {
    margin-top: 0 !important;
}
.margin {
    margin: 5px;
}
.form-green-color{
    color: green;
}
.xff-item-ginfo {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.xff-item-paragraph-font {
    font-size: 13px;    
}
.bottom-margin {
	margin-bottom: 5px;
}
.ro-font {
	color: black;
	font-weight: bold;
}
.sort-style {
		font-weight: bold;
}

</ui:style>

<!--
*********************************************************************
This is the UI for sharing Note/Item with Groups
*********************************************************************
-->

<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
 	    <b:BlockQuote addStyleNames="{style.xff-item-ginfo}" ui:field='helpBlockQuote' visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.xff-item-paragraph-font}' HTML="{i18n.shareWithGroupsHelp}"/>
		</b:BlockQuote>
		<b:Row>
				<b:Panel type="PRIMARY">
                                        <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.shareWithGroups}"/>
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">
								<b:Row>
									<m:ObidosButtonToolBar ui:field="buttonToolBar">
										<b:Button type="PRIMARY" ui:field='listButton'  text="{i18n.listItemsInContainer}" visible="false" />
									</m:ObidosButtonToolBar>
								</b:Row>
								

                                    <m:ObidosRowBottom2px>
										<b:FormLabel ui:field='nameLabel' addStyleNames="col-sm-4" text="{i18n.itemName}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
            								<b:InputGroup>
  											 <b:InputGroupAddon icon="UNLOCK" iconColor="red" iconPosition="RIGHT"/>
												<m:ObidosTextBox ui:field="nameTextBox" addStyleNames="{style.ro-font}" readOnly="true"/>
											</b:InputGroup>
										</g:FlowPanel>
                                    </m:ObidosRowBottom2px>

    								<b:Row>
										<b:FormLabel for="forComment" ui:field='commentLabel' addStyleNames="col-sm-4" text="Comment"/>
										<g:FlowPanel addStyleNames="col-sm-4 {style.bottom-margin}">
											<m:ObidosTextBox ui:field="shareCommentTextBox" placeholder="Sharing Comment" enabled="true"/>
										</g:FlowPanel>
									</b:Row>

                                    <m:ObidosRowBottom2px>
										<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4" text="{i18n.search}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosTextBox ui:field="searchTextBox" placeholder='Search groups to Share' enabled="true"/>
												<b:InputGroupButton>
    												<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text=""/>
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

                                    <!-- issue 659 -->
									<m:ObidosRow bottomMargin="{i18n.bottomMargin}" visible="false">
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.sendNotificationEmail}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											  <b3:ToggleSwitch ui:field="sendNotificationEmailSwitch" size="SMALL" onColor="SUCCESS" offColor="DANGER" onText="✓" offText="✗" value="false"/>
										  </g:FlowPanel>
									</m:ObidosRow>

								    <m:ObidosMessageRow ui:field="messageRow"/>

									<b:Row>
										<m:ObidosClearSelectionsButton ui:field="clearButton"/>
                                        <m:ObidosShareButton ui:field="shareButton" tooltip="{i18n.selectGroupsAndClickToShare}"/>
										<b:ButtonGroup>
											<b:Button type="LINK" icon="SORT" addStyleNames="{style.sort-style}" dataToggle="DROPDOWN" toggleCaret="false" text="{i18n.sort}" />
											<b:DropDownMenu>
												<b:AnchorListItem icon="CHEVRON_CIRCLE_DOWN" ui:field="sortByDate" text="{i18n.sortByUpdatedDate}" />
												<b:AnchorListItem icon="CHEVRON_CIRCLE_UP" ui:field="sortReverseByDate" text="{i18n.sortReverseByUpdatedDate}" />
												<b:AnchorListItem icon="SORT_ALPHA_ASC" ui:field="sortByAZ" text="{i18n.sortByGroupAZ}" />
												<b:AnchorListItem icon="SORT_ALPHA_DESC" ui:field="sortByZA" text="{i18n.sortByGroupZA}" />
											</b:DropDownMenu>
										</b:ButtonGroup>
									</b:Row>
							</b:Form>

							 <b.gwt:DataGrid bordered="true" addStyleNames='{style.itemShareGroupDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid"/>
							  <g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
								  <tr>
									<td align='center'>
									  <c:SimplePager ui:field='pager' />
									</td>
								  </tr>
								</table>
							  </g:HTMLPanel>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.resetpass-form-danger {
		background-color: #fcf2f2;
		border-color: #dFb5b4;
	}
	
	.resetpass-margin-fix {
		margin-top: 0 !important;
	}
	
	.fck-title {
		color: #666;
		font-size: 18px;
		font-weight: 400;
		display: block;
	}
	
	.top-margin {
		margin-top: 10px;
	}
	
	.help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.help-paragraph-font {
		font-size: 13px;
	}
	
	.top-margin {
		margin-top: 5px;
		margin-bottom: 5px;
	}
	
	.suggestionListColor {
		color: #009999;
	}
	</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container>
			<b:Row>
				<b:BlockQuote addStyleNames="{style.help-bq} {style.top-margin}" ui:field='helpBlockQuote' visible="false">
					<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="{i18n.resetPasswordHelp}" />
				</b:BlockQuote>

				<b:Heading size="H1" addStyleNames='{style.fck-title}' text="{i18n.welcome}" />
				<b:Panel ui:field='panel' type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.resetPasswordPanelHeading}" />
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">
								<b:Row>
									<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
										<b.html:Strong text="{i18n.resetPasswordsuggestionForStringPassword}" />
										<b:ListGroup addStyleNames='{style.suggestionListColor}'>
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp1}" type="DEFAULT" />
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp2}" type="DEFAULT" />
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp3}" type="DEFAULT" />
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp4}" type="DEFAULT" />
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp5}" type="DEFAULT" />
										</b:ListGroup>
									</g:FlowPanel>
								</b:Row>

								<b:Row>
									<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
										<b.html:Strong text="{i18n.passwordRequirementsLabel}" />
										<b:ListGroup ui:field='passwordRequirementListGroup'>
											<b:ListGroupItem HTML="{i18n.passwordRequirementHelp1}" type="DEFAULT" />
										</b:ListGroup>
									</g:FlowPanel>
								</b:Row>


								<m:ObidosRowBottom2px>
									<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-4">
										<b:Label ui:field="ncharsLabel" text="0" type="DEFAULT" />
									</g:FlowPanel>
								</m:ObidosRowBottom2px>

								<m:ObidosRowBottom2px>
									<b:FormLabel addStyleNames="col-sm-4" text="{i18n.newPassword}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<b:InputGroup>
											<m:ObidosPasswordBox ui:field="passwordBox" placeholder="{i18n.password}" allowBlank="false" />
											<b:InputGroupButton>
												<b:Button type="INFO" icon="EYE" ui:field='showHidePasswordButton' text="" />
											</b:InputGroupButton>
										</b:InputGroup>
									</g:FlowPanel>
								</m:ObidosRowBottom2px>

								<m:ObidosRowBottom2px>
									<b:FormLabel for="forConfirmPassword" addStyleNames="col-sm-4"
										text="{i18n.resetPasswordConfirmPassword}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<b:InputGroup>
											<m:ObidosPasswordBox ui:field="confirmPasswordBox"
												placeholder="{i18n.resetPasswordConfirmPassword}" />
											<b:InputGroupButton>
												<b:Button type="INFO" icon="EYE"
													ui:field='showHideConfirmPasswordButton' text="" />
											</b:InputGroupButton>
										</b:InputGroup>

									</g:FlowPanel>
								</m:ObidosRowBottom2px>

								<!-- 2FA stuff -->
								<g:FlowPanel ui:field='require2faFp'
									addStyleNames="col-sm-12 {style.top-margin}">
									<b:Row ui:field='require2faRow'>
										<b:Row>
											<b:FormLabel ui:field="requiresTwoFAPasswordResetLabel" addStyleNames="col-sm-4" text="{i18n.requires2FA}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<b3:ToggleSwitch ui:field='requiresTwoFAPasswordResetSwitch' size="SMALL" onColor="SUCCESS" offColor="DANGER" onText="✓" offText="✗" value="true" readOnly="true" />
											</g:FlowPanel>
										</b:Row>

										<m:ObidosRowBottom2px>
											<g:FlowPanel ui:field="badge1Flow"
												addStyleNames="col-sm-offset-4 col-sm-8">
												<g:HTMLPanel>
													<g:HTML HTML="{i18n.getVerificationCode}" />
												</g:HTMLPanel>
											</g:FlowPanel>
										</m:ObidosRowBottom2px>

										<m:ObidosRowBottom2px ui:field="twofaRow">
											<b:FormLabel addStyleNames="col-sm-4"
												text="{i18n.enterVaidationCodeLabel}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field='twofaCodeBox'
													placeholder="{i18n.enterValidationCodeFromGoogleAuthenticator}" />
											</g:FlowPanel>
										</m:ObidosRowBottom2px>
									</b:Row>
								</g:FlowPanel>

								<m:ObidosMessageRow ui:field="messageRow" />

								<b:Row>
									<m:ObidosButtonToolBar ui:field="buttonToolBar">
										<b:Button type="SUCCESS" ui:field='resetButton' text="{i18n.resetPasswordButtonTitle}" />
										<b:Button type="PRIMARY" ui:field='loginButton' text="{i18n.resetPasswordLoginWithNewPassword}" />
									</m:ObidosButtonToolBar>
								</b:Row>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>

	</g:HTMLPanel>
</ui:UiBinder>                

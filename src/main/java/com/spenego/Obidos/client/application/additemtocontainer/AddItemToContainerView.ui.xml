<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:f='urn:import:org.vectomatic.file' xmlns:v='urn:import:org.vectomatic.dnd'
	xmlns:h="urn:import:com.google.gwt.canvas.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:b2="urn:import:org.gwtbootstrap3.extras.datepicker.client.ui"
    xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
    xmlns:u="urn:import:org.wisepersist.gwt.uploader.client"
    xmlns:select="urn:import:org.gwtbootstrap3.extras.select.client.ui"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.item-message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.form-error-label {
		color: red;
	}
	
	.item-ginfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.list-style ul li {
		margin: 0;
		padding: 0;
		list-style-type: square;
		text-align: left;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.item-paragraph-font {
		font-size: 13px;
	}
	
	.item-margin {
		margin: 5px;
	}
	
	.bs-label {
		white-space: nowrap !important;
		overflow: hidden !important;
		text-overflow: ellipsis !important;
	}
	
	.readonly-font {
		color: black;
		font-weight: bold;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	
	.spacer {
		margin: 0;
		padding: 0;
		height: 1em;
	}
	.utc-timebox {
		display: block;
		width: 120px;
		height: 34px;
		padding-top: 6px;
		padding-bottom: 6px;
		padding-right: 0px;
		padding-left: 0px;
		font-size: 14px;
		font-weight: bold;
		text-align: center;
		line-height: 1.42857143;
		color: #000;
		background-color: #fff;
		background-image: none;
		border: 1px solid #ccc;
		border-radius: 4px;
		-webkit-box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
		box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
		-webkit-transition: border-color ease-in-out .15s, -webkit-box-shadow ease-in-out .15s;
		-o-transition: border-color ease-in-out .15s, box-shadow ease-in-out .15s;
		transition: border-color ease-in-out .15s, box-shadow ease-in-out .15s
	}
	.no-left-margin {
		padding-left: 0px;
		margin-left: 1px;
	}
	.width-adjust {
		width: 15.0% !important;
	}
	.no-right-margin {
		padding-right: 0px;
		margin-right: 1px;
	}
	.ro-font{
		color: black;
		font-weight:bold;
	}
    .upload-padding {
       padding-top: 4px !important;
       padding-left: 1px !important;
    }
.uhr {
	border-bottom: 1px solid #ccc;
	padding-bottom: 2px;
	margin-bottom: 4px;
}
.fp-bottom-margin {
	margin-bottom: 5px;
}
.checkmark-label {
    color: #58B957;
	font-weight:bold;
	margin-left: 5px;
}
.cross-label {
    color: #ff0000;
	font-weight:bold;
	margin-left: 5px;
}
.btn-margin {
    margin-left: 5px;
}
.totp-textbox {
    font-family: monospace;
    margin-left: 4px;
}
.top-margin {
    margin-top: 3px;
}
.bottom-margin {
	margin-bottom: 3px;
}
.file_chosen {
   padding-left: 0px;
   margin-left: 0px;
}
.customSelect button {
    color: #000 !important;
}
.wifi-qrcode-image-margin {
    margin-left: -1px;
}
.wifi-hidden-switch {
    margin-left: 20px;
    margin-right:50px;
}

/* Adjust the toggle switch position */
/* By Claude AI Sonnet 3.5 starts */
.wifi-toggle-container {
  padding-left: 15px;  /* Space after the lock icon */
}
.info_label {
   margin-left: -20px;
   font-size: 12px;
   weight: bold;
   color: #9900ff !important;
}
/* By Claude AI Sonnet 3.5 ends */
    /* https://www.w3schools.com/howto/tryit.asp?filename=tryhow_css_loader */
    /* I seem to like this one better */
    .loading {
        display: inline-flex;
        align-items: center;
        margin-left: 10px; 
        position: relative; 
        top: 7px; 
        /* position: absolute; */
        /*margin-left: 4px;*/
        /*top: 50%;*/
        /* left: 65%; */
    }
	.loader {
	  border: 2px solid #f3f3f3;
	  border-radius: 50%;
	  /* border-top: 2px solid #3498db; */
	  border-top: 2px solid #9900ff;
	  width: 16px;
	  height: 16px;
	  -webkit-animation: spin 2s linear infinite; /* Safari */
	  animation: spin 2s linear infinite;
	}

	/* Safari */
	@-webkit-keyframes spin {
	  0% { -webkit-transform: rotate(0deg); }
	  100% { -webkit-transform: rotate(360deg); }
	}

	@keyframes spin {
	  0% { transform: rotate(0deg); }
	  100% { transform: rotate(360deg); }
	}
</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.item-ginfo} {style.list-style}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.item-paragraph-font}' HTML='{i18n.createNewItemHelp}' />
			</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.createNewItem}" />
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">
								<b:Row>
									 <!--  Language -->
									<m:ObidosRowBottom2px ui:field="languageRow">
										 <b:FormLabel for="languagel" b:id="languagel" addStyleNames="col-sm-4" HTML="Language" />
										 <g:FlowPanel addStyleNames="col-sm-4">
											<b:ListBox b:id="languagelb" ui:field='languageListBox'>
												<g:item>English</g:item>
												<g:item>বাংলা</g:item>
											</b:ListBox>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									<!--  Bug 76 starts -->
									<m:ObidosRowBottom2px>
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<b:InputGroupAddon icon="UNLOCK" title="{i18n.notEncrypted}" iconColor="{i18n.unlockColor}" iconPosition="RIGHT" />
												<m:ObidosTextBox ui:field="containerNameTextBoxNew" readOnly="true" addStyleNames='{style.readonly-font}' placeholder="{i18n.containerNameLabel}" />
											</b:InputGroup>
										</g:FlowPanel>
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:FormLabel ui:field='containerShareableLabel' addStyleNames='{style.info_label}' HTML="" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									<!--  Bug 76 ends -->

<!--
									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='containerNameLabel' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
										<g:FlowPanel addStyleNames="col-sm-5">
											<b:InputGroup>
												<b:InputGroupAddon icon="UNLOCK" title="{i18n.notEncrypted}" iconColor="{i18n.unlockColor}" iconPosition="LEFT" />
												<m:ObidosTextBox ui:field="containerNameTextBox" readOnly="true" addStyleNames='{style.readonly-font}' placeholder="{i18n.containerNameLabel}" />
												<m:ObidosInputGroupAddon ui:field="typeAddon" />
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
-->
									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='templateNameLabel' addStyleNames="col-sm-4" text="{i18n.templateNameLabel}" visible="true" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<b:InputGroupAddon icon="UNLOCK" title="{i18n.notEncrypted}" iconColor="{i18n.unlockColor}" iconPosition="LEFT" visible="true"/>
												<m:ObidosTextBox ui:field="templateNameTextBox" placeholder="{i18n.containerTypeLabel}" readOnly="true" addStyleNames='{style.readonly-font}' visible="true" />
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='itemNameLabel' addStyleNames="col-sm-4" text="{i18n.itemNameLabel}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<b:InputGroupAddon icon="UNLOCK" title="{i18n.notEncrypted}" iconColor="red" iconPosition="LEFT"/>
												<m:ObidosTextBox ui:field="itemNameTextBox" b:id="item" placeholder="{i18n.itemNameLabel}" enabled="true" />
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
								</b:Row>
								
								<!--  hidden Wifi QRCode block starts -->
								<b:Row ui:field='wifiQRCodeRow' visible="false">
									<m:ObidosItemRow ui:field='ssidItemRow' readOnly="false" 
															labelText="Network Name (SSID)" 
															fieldText="" 
															isSecure="true" />								
									<m:ObidosItemRow ui:field='passwordItemRow' readOnly="false" 
															labelText="WiFi Password" 
															fieldText="" 
															isSecure="true" />								

<!-- 
									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='ssidLabel' addStyleNames="col-sm-4" text="Network Name (SSID)" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<b:InputGroupAddon icon="LOCK" title="{i18n.encrypted}" iconColor="green" iconPosition="LEFT"  />
												<m:ObidosTextBox ui:field="ssidNameTextBox" b:id="ssid" placeholder="SSID" enabled="true" />
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									-->
									<m:ObidosRowBottom2px visible="false">
										<b:FormLabel ui:field='wifiPasswordLabel' addStyleNames="col-sm-4" text="Password" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<b:InputGroupAddon icon="LOCK" title="{i18n.encrypted}" iconColor="green" iconPosition="LEFT" />
												<m:ObidosTextBox ui:field="wifiPasswordTextBox" b:id="wifipassword" placeholder="WiFi Password" enabled="true" />
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='wifiEncryptionLabel' addStyleNames="col-sm-4" text="Encryption" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<b:InputGroupAddon ui:field='wifiEntryptionInputGroupAddon' icon="LOCK" title="{i18n.encrypted}" iconColor="green" iconPosition="LEFT" />
                                               <select:Select addStyleNames="{style.customSelect}" liveSearch="false" ui:field="wifiEncryptionSelect" showTick="true">
                                                   <select:Option text="{i18n.wpa}"/>
                                                   <select:Option text="{i18n.wep}"/>
                                                   <select:Option text="{i18n.nopass}"/>
                                               </select:Select>
											</b:InputGroup>
										</g:FlowPanel>

									</m:ObidosRowBottom2px>
									<!--  WiFi Hidden row -->
									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='wifiHiddenLabelN' addStyleNames="col-sm-4" text="Hidden Network" />
										<g:FlowPanel addStyleNames="col-sm-4">
                                            <b:InlineRadio ui:field='hiddenYesRadio' name="radioHN" formValue="Yes" text="Yes" value="false"/>
                                            <b:InlineRadio ui:field='hiddenNoRadio' name="radioHN" formValue="No" text="No" value="true"/>
                                            <!--  busy circle -->
                                             <g:HTMLPanel ui:field="workingPanel" addStyleNames="{style.loading}" visible="false">
                                                <span class="{style.loader}"></span>
                                             </g:HTMLPanel>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									<m:ObidosRowBottom2px visible="false">
										<b:FormLabel ui:field='wifiHiddenLabel' addStyleNames="col-sm-4" text="Hidden Network" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<b:InputGroupAddon ui:field='wifiHiddenNetworkInputGroupAddon' icon="LOCK" title="{i18n.encrypted}" iconColor="green" iconPosition="LEFT"/>
						   		                <g:FlowPanel addStyleNames="{style.wifi-toggle-container}">
						   		                     <b3:ToggleSwitch ui:field="wifiHiddenToggleSwitch" onText="Yes" offText="No"/>
                                                </g:FlowPanel>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									<m:ObidosRowBottom2px ui:field='wifiQrCodeImageRow'>
										<b:FormLabel addStyleNames="col-sm-4" text="WiFi QR Code"/>
										<g:FlowPanel addStyleNames="col-sm-4 {style.wifi-qrcode-image-margin}">
											<b:Image type="THUMBNAIL" ui:field="wifiQrCodeImage" url="128x128.png" title="QR Code Image Placeholder"/>
											<b:FormLabel ui:field="wifiQrcodeCheckMarkLabel" addStyleNames="{style.checkmark-label}" text="✓" visible="false"/>
											<b:FormLabel ui:field="wifiCrossLabel" addStyleNames="{style.cross-label}" text="✗" visible="true"/>
											<!-- ✓ -->
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
								</b:Row>
								<!--  hidden Wifi QRCode block ends -->

								<b:FormGroup ui:field='formGroup'>
								</b:FormGroup>

                                <!--  upload file -->
								<m:ObidosRowBottom2px ui:field='addAttachmentRow'>
									<b:FormLabel addStyleNames="col-sm-4" text="{i18n.addAttachment}"/>
									<g:FlowPanel addStyleNames="col-sm-4 {style.fp-bottom-margin}">
										<b3:ToggleSwitch ui:field='addAttachmentSwitch' size="SMALL" onText="✓" offText="✗" onColor="SUCCESS" offColor="DANGER" value="false" />
									</g:FlowPanel>
								</m:ObidosRowBottom2px>

								<m:ObidosRowBottom2px ui:field='uploadRow' addStyleNames="col-sm-offset-1" visible="false">
									<b:FormLabel addStyleNames="col-sm-4" text="{i18n.selectFile}"/>
										<!--  new HTML5 with progress bar -->
										<g:FlowPanel addStyleNames="col-sm-4">
											<g:FormPanel ui:field='uploadFormPanelWise'>
											    <u:Uploader ui:field='wiseUploader'/>
											 </g:FormPanel>
										</g:FlowPanel>
										<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-8">
											 <b.html:Span ui:field='fileChosenSpan' addStyleNames="{style.file_chosen}" text="{i18n.noFileChosen}"/>
										</g:FlowPanel>
								</m:ObidosRowBottom2px>
								<!-- add 2fa info -->
                                    <b:Row>
                                        <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-7">
                                            <b:Row addStyleNames="{style.uhr}" />
                                        </g:FlowPanel>
                                    </b:Row>

                                    <!--  QR Code starts -->
                                    <m:ObidosRowBottom2px ui:field='add2FASwitchRow'>
                                        <b:FormLabel addStyleNames="col-sm-4" text="{i18n.add2FAInfo}"/>
                                        <g:FlowPanel addStyleNames="col-sm-4 {style.fp-bottom-margin}">
                                            <b3:ToggleSwitch ui:field='add2FASwitch' size="SMALL" onText="✓" offText="✗" onColor="SUCCESS" offColor="DANGER" value="false" />
                                        </g:FlowPanel>
                                    </m:ObidosRowBottom2px>

                                    <b:Row ui:field='qrCodeInfoRow' visible="false" addStyleNames="col-sm-offset-1">
                                        <b:Row visible="false">
                                            <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-7">
                                                <b:Row addStyleNames="{style.uhr}" />
                                            </g:FlowPanel>
                                        </b:Row>
                                        
                                        <!--  upload 2FA QR Code Image -->
                                        <m:ObidosRowBottom2px ui:field='qrCodeUploadRow'>
                                            <b:FormLabel addStyleNames="col-sm-4" text="{i18n.selectQRCodeImageFile}"/>
                                                <g:FlowPanel addStyleNames="col-sm-8">
                                                <f:FileUploadExt ui:field="qrCodefileUploadHTML5" addStyleNames="{style.upload-padding}" />
                                                </g:FlowPanel>
                                        </m:ObidosRowBottom2px>

                                        <!-- QR Code Image -->
                                        <m:ObidosRowBottom2px ui:field='qrCodeImageRow' visible="false">
                                            <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-7">
                                                <b:Image type="THUMBNAIL" ui:field="qrCodeImage" url="128x128.png" title="QR Code Image Placeholder"/>
                                                <b:FormLabel ui:field="checkMarkLabel" addStyleNames="{style.checkmark-label}" text="✓" visible="false"/>
                                                <b:FormLabel ui:field="crossLabel" addStyleNames="{style.cross-label}" text="✗" visible="true"/>
                                                <!-- ✓ -->
                                            </g:FlowPanel>

                                            <m:ObidosRowBottom2px ui:field='qrCodeThumbnailImageRow'>
                                                <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-7" visible="false">
                                                    <b:Image type="THUMBNAIL" ui:field="qrCodeResizerImage" url="128x128.png"/>
                                                </g:FlowPanel>
                                            </m:ObidosRowBottom2px>

                                            <m:ObidosRowBottom2px>
                                                <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-7">
                                                <!--
                                                   <b:Button type="DANGER" width="108.9px" size="EXTRA_SMALL" ui:field='qrCodeResetButton' addStyleNames="{style.btn-margin}" text="CLEAR" visible="true" />
                                                   -->
                                                   <b:Button type="DANGER" width="130px" size="EXTRA_SMALL" ui:field='qrCodeResetButton' addStyleNames="{style.btn-margin}" text="CLEAR" visible="true" />
                                                   <b:Button type="PRIMARY" width="130px" size="EXTRA_SMALL" addStyleNames="{style.btn-margin}" ui:field='show2FACodeButton' text="Show 2FA Code" visible="false" />
                                                </g:FlowPanel>
                                            </m:ObidosRowBottom2px>

                                            <!--  show 2FA code -->
                                            <!-- 
                                            <b:Row ui:field="twoFACodeRow" visible="false">
                                                <b:FormLabel addStyleNames="col-sm-4" text="2FA Code" />
                                                <g:FlowPanel addStyleNames="{style.blink-me} col-sm-2">
                                                     <b:TextBox ui:field="twoFACodeTextBox" addStyleNames="{style.code-textbox} text-center" enabled="false" text="123 456"/>
                                                </g:FlowPanel>
                                            </b:Row>
                                            -->

                                            <m:ObidosRowBottom2px ui:field='totpUriRow' addStyleNames="{style.top-margin}" visible="true">
                                                <b:FormLabel addStyleNames="col-sm-4" text="TOTP OtpAuth URI" />
                                                <g:FlowPanel addStyleNames="col-sm-7">
                                                     <m:ObidosTextBox ui:field="totpUriTextBox" addStyleNames='{style.totp-textbox}' readOnly="true" />
                                                </g:FlowPanel>
                                            </m:ObidosRowBottom2px>
                                        </m:ObidosRowBottom2px>

                                        <!-- Canvas for resizing big image -->
                                        <b:Row visible="false">
                                            <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-8">
                                                <g:SimplePanel ui:field="simplePanel">
                                                    <h:Canvas ui:field="qrCodeCanvas" />
                                                </g:SimplePanel>
                                            </g:FlowPanel>
                                        </b:Row>

                                        
                                        <!-- Enter QR Code info manually -->
                                        <b:Row addStyleNames="{style.bottom-margin}" visible="true">
                                            <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-8">
                                                <b:CheckBox ui:field="qrCodeManualCheckBox" text="{i18n.enter2FAQRCodeInfoManually}"/>
                                            </g:FlowPanel>
                                        </b:Row>
                                        
                                        <!--  Issuer -->
                                        <b:Row ui:field="qrCodeManualTextBoxesRow" visible="false">
                                            <b:Row addStyleNames="{style.bottom-margin}" visible="true">
                                                <b:FormLabel addStyleNames="col-sm-4" HTML="{i18n.twoFAissuer}"/>
                                                <g:FlowPanel addStyleNames="col-sm-4">
                                                    <b:TextBox ui:field="issuerTextBox" placeholder="Example Co" />
                                                </g:FlowPanel>
                                            </b:Row>

                                            <!-- Account -->
                                            <b:Row addStyleNames="{style.bottom-margin}" visible="true">
                                                <b:FormLabel addStyleNames="col-sm-4" HTML="{i18n.twoFAAccount}"/>
                                                <g:FlowPanel addStyleNames="col-sm-4">
                                                    <b:TextBox ui:field="accountTextBox" placeholder="jdoe@example.com" />
                                                </g:FlowPanel>
                                            </b:Row>

                                            <!-- Secret -->
                                            <b:Row addStyleNames="{style.bottom-margin}" visible="true">
                                                <b:FormLabel addStyleNames="col-sm-4" HTML="{i18n.twoFASecret}" />
                                                <g:FlowPanel addStyleNames="col-sm-4">
                                                    <b:TextBox ui:field="secretTextBox" placeholder="6XNEULU6H6LWLFRX2TIE3YNYL4MKAJXR" />
                                                </g:FlowPanel>
                                            </b:Row>

                                            <b:Row>
                                                <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-7" visible="true">
                                                    <b:Button type="PRIMARY" size="EXTRA_SMALL" ui:field='genURIButton' text="Generate TOTP URI" />
                                                </g:FlowPanel>
                                            </b:Row>

                                        </b:Row>
                                    </b:Row>


                                    <b:Row ui:field='bottomUhrRow'>
                                        <g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-7">
                                            <b:Row addStyleNames="{style.uhr}" />
                                        </g:FlowPanel>
                                    </b:Row>

								<b:Row>
									<m:ObidosRowBottom2px>
										<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-4">
											<b:InlineRadio name="radio1" formValue="public" ui:field='publicItemRadio' text="{i18n.shareableItem}" value="false" />
											<b:InlineRadio name="radio1" formValue="private" ui:field='privateItemRadio' text="{i18n.privateItem}" value="false" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRow ui:field="expiresRow" bottomMargin="2px">
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.shareExpirationDateOptional}" />
										<g:FlowPanel addStyleNames="col-sm-2 {style.width-adjust} {style.no-right-margin}">
											<b:InputGroup>
												<b:InputGroupAddon icon="UNLOCK" title="{i18n.notEncrypted}" iconColor="{i18n.unlockColor}" iconPosition="LEFT" />
												<b2:DatePicker ui:field="datePicker" addStyleNames="{style.ro-font}" highlightToday="true" autoClose="true" placeholder="{i18n.dateFormat}" position="TOP_LEFT" readOnly="false"/>
											</b:InputGroup>
										</g:FlowPanel>
										<g:FlowPanel addStyleNames="col-sm-1 {style.no-left-margin} {style.no-right-margin}">
												<m:ObidosTimeBox ui:field="timeBox" addStyleNames="{style.utc-timebox}"/>
										</g:FlowPanel>
									</m:ObidosRow>
								</b:Row>


								<m:ObidosMessageRow ui:field="messageRow" />

								<b:Row>
									<m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
										<b:Button type="SUCCESS" ui:field='saveButton' width="127px" b:id="create" text="{i18n.create}" />
										<b:Button type="PRIMARY" ui:field='listButton' width="127px" text="{i18n.listMyContainers}" visible="false" />
										<b:Button type="PRIMARY" ui:field='listItemsButton' width="127px" text="{i18n.items}" visible="false" />
									</m:ObidosButtonToolBar>
								</b:Row>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
    xmlns:b='urn:import:org.gwtbootstrap3.client.ui'
    xmlns:g='urn:import:com.google.gwt.user.client.ui'
    xmlns:b.html='urn:import:org.gwtbootstrap3.client.ui.html'> 

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.x-info {
	background-color:  #EEEEEE;
	border-color: #2F79B9;
}
.margin-fix-y {
	margin-top: 0 !important;
}
.paragraph-font-y {
    font-size: 13px;    
}
</ui:style>

<g:HTMLPanel>
<br/>
	<b:Container>
	  <b:BlockQuote addStyleNames="{style.x-info}" ui:field='helpBlockQuote'>
		  <b:Heading ui:field="panelHeading" addStyleNames='{style.margin-fix-y}' size="H5" text="{i18n.passwordChangedPanelHeading}"/>
		  <!-- note list does not work if set here, we'll set them in presenter  -->
			<b.html:Paragraph ui:field='passwordChangedParagraph' addStyleNames='{style.paragraph-font-y}' HTML="{i18n.passwordChangedMessage}"/>
        </b:BlockQuote>   
        <b:Row>
            <b:Column size="XS_12">
                <b:FormGroup>
                    <b:Row>
                        <g:FlowPanel addStyleNames="col text-center">
                            <b:Button type="SUCCESS" ui:field="loginButton" b:id="loginNew" text="{i18n.passwordChangedButtonTitle}"/>
                        </g:FlowPanel>
                    </b:Row>
                </b:FormGroup>
            </b:Column>
        </b:Row>
    </b:Container>
</g:HTMLPanel>

</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<!-- https://isabelcastillo.com/error-info-messages-css -->
	<ui:style gss="true">
	.message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.message-error {
		margin: 10px 10px;
		padding: 12px;
		color: #D8000C;
		background-color: #FFBABA;
		box-shadow: 1px 1px 3px #888;
	}
	
	.form-error-label {
		color: red;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.margin {
		margin: 5px;
	}
	
	.addUsersToGroupDataGridCell td div {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.xff-item-ginfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.xff-item-paragraph-font {
		font-size: 13px;
	}
	</ui:style>


	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:BlockQuote addStyleNames="{style.xff-item-ginfo}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.xff-item-paragraph-font}' HTML="{i18n.addUsersToGroupHelp}" />
			</b:BlockQuote>
			<b:Row>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.addUsersToGroup}" />
					<b:PanelBody>
						<b:Form type="HORIZONTAL">
							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forGroupName" ui:field='groupNameLabel'
									addStyleNames="col-sm-4" text="{i18n.group}" />
								<g:FlowPanel addStyleNames="col-sm-4">
									<m:ObidosInputGroup ui:field="groupNameInputGroup"
										readOnly="true" isSecure="false" placeHolder="{i18n.groupname}" />
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forCommentsLabel" ui:field='commentsLabel'
									addStyleNames="col-sm-4" text="{i18n.commentLabel}" />
								<g:FlowPanel addStyleNames="col-sm-6">
									<m:ObidosTextArea ui:field="commentsTextArea" maxLength="255" enabled="false" />
								</g:FlowPanel>
							</m:ObidosRow>


							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forSearchLabel" ui:field='searchLabel'
									addStyleNames="col-sm-4" text="{i18n.searchButtonTitle}" />
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup>
										<m:ObidosTextBox ui:field="serachTextBox"
											placeholder="{i18n.searchUsersToAddToGroup}" enabled="true" />
										<b:InputGroupButton>
											<b:Button type="INFO" icon="SEARCH" ui:field='searchUserButton'
												text="" />
										</b:InputGroupButton>
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosMessageRow ui:field="messageRow" />

							<b:Row>
								<m:ObidosClearSelectionsButton ui:field="clearButton" />
								<m:ObidosAddButton ui:field="addUserButton" />
							</b:Row>
						</b:Form>

						<g:HTMLPanel>
							<b.gwt:DataGrid bordered="true" addStyleNames='{style.addUsersToGroupDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
							<g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
									<tr>
										<td align='center'>
											<c:SimplePager ui:field='pager' />
										</td>
									</tr>
								</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.item-message-info {
		margin: 10px 10px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.item-message-error {
		margin: 10px 10px;
		padding: 12px;
		color: #D8000C;
		background-color: #FFBABA;
		box-shadow: 1px 1px 3px #888;
	}
	
	.sitem-data-grid-cell td div {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.form-error-label {
		color: red;
	}
	
	.help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.help-paragraph-font {
		font-size: 13px;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.bottom-margin {
		margin-bottom: 4px;
	}
	
	.sort-style {
		font-weight: bold;
	}
	</ui:style>


	<g:HTMLPanel ui:field="mainHtmlPanel">
		<b:Container>
			<b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="TODO" />
			</b:BlockQuote>
			<b:Panel type="PRIMARY">
				<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.listOfItemsInContainer}" />
				<b:PanelBody>
					<g:HTMLPanel>
						<b:Form type="HORIZONTAL">
							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel ui:field='containerNameLabelX' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
								<g:FlowPanel addStyleNames="col-sm-4">
									<m:ObidosInputGroup ui:field="nameInputGroup" readOnly="true" isSecure="false" placeHolder="" />
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forSearchName" addStyleNames="col-sm-4" text="{i18n.search}" />
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup>
										<m:ObidosTextBox ui:field='searchTextBox' placeholder="{i18n.searchItemName}" />
										<b:InputGroupButton>
											<b:Button ui:field="searchButton" type="PRIMARY" icon="SEARCH" />
										</b:InputGroupButton>
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosMessageRow ui:field="messageRow" />

							<b:Row>
								<m:ObidosClearSelectionsButton
									ui:field="clearButton" />
								<m:ObidosRelinquishButton ui:field="relinquishButton" />
								<b:ButtonGroup>
									<b:Button type="LINK" icon="SORT" addStyleNames="{style.sort-style}" dataToggle="DROPDOWN" toggleCaret="false" text="{i18n.sort}" />
									<b:DropDownMenu>
										<b:AnchorListItem icon="CHEVRON_CIRCLE_DOWN" ui:field="sortByDate" text="&nbsp;&nbsp;{i18n.sortByUpdatedDate}" />
										<b:AnchorListItem icon="CHEVRON_CIRCLE_UP" ui:field="sortReverseByDate" text="&nbsp;&nbsp;{i18n.sortReverseByUpdatedDate}" />
										<b:AnchorListItem icon="SORT_ALPHA_ASC" ui:field="sortByAZ" text="&nbsp;&nbsp;{i18n.sortByAlphabetAZ}" />
										<b:AnchorListItem icon="SORT_ALPHA_DESC" ui:field="sortByZA" text="&nbsp;&nbsp;{i18n.sortByAlphabetZA}" />
									</b:DropDownMenu>
								</b:ButtonGroup>

							</b:Row>
						</b:Form>

						<b.gwt:DataGrid addStyleNames='{style.sitem-data-grid-cell}' bordered="true" condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
						<g:HTMLPanel ui:field="htmlPanel">
							<table style="width:100%">
								<tr>
									<td align='center'>
										<c:SimplePager ui:field='pager' />
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</b:PanelBody>
			</b:Panel>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

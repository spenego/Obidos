<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.centered {
		margin: auto;
		max-width: 600px;
	}
	.panel-header {
        background-color: #ff0000 !important;
        text-color: white;
    }
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
				<b:Panel type="DANGER">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.pageNotFound}" />
					<b:PanelBody>
						<b:Row addStyleNames="{style.centered}">
							<g:HTMLPanel>
								<g:HTML ui:field='infoHtml' />
								<g:HTML ui:field='buildHtml' />
							</g:HTMLPanel>
						</b:Row>
					    <m:ObidosMessageRow ui:field="messageRow"/>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>
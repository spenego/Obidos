<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:summer="urn:import:com.spenego.Obidos.client.application.widgets.summernote"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
    xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<!-- https://isabelcastillo.com/error-info-messages-css -->
	<ui:style gss="true">
	.share-item-message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.share-item-message-error {
		margin: 10px 0px;
		padding: 12px;
		color: #D8000C;
		background-color: #FFBABA;
		box-shadow: 1px 1px 3px #888;
	}
	
	.item-groups-datagrid td div {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.form-error-label {
		color: red;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.margin {
		margin: 5px;
	}
	
	.help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.help-paragraph-font {
		font-size: 13px;
	}
	
	.ro-font {
		color: black;
		font-weight: bold;
	}
	</ui:style>

	<!-- ********************************************************************* This is the UI 
		for revoking a Note/Item from Groups ********************************************************************* -->

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="{i18n.revokeItemSharedWithGroupsHelp}" />
			</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.revokeItemSharedWithGroups}" />
					<b:PanelBody>
						<b:Form type="HORIZONTAL">
							<m:ObidosRow bottomMargin="2px" ui:field="containerRow">
								<b:FormLabel for="forContainerName" ui:field='containerNameLabel' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup ui:field='containerNameInputGroup'>
										<b:InputGroupAddon icon="UNLOCK" iconColor="red" iconPosition="RIGHT" />
										<m:ObidosTextBox ui:field="containerNameTextBox" addStyleNames='{style.ro-font}' readOnly="true" />
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosRow bottomMargin="10px">
								<b:FormLabel for="forNoteName" ui:field='itemNameLabel' addStyleNames="col-sm-4" text="{i18n.itemNameLabel}" />
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup>
										<b:InputGroupAddon icon="UNLOCK" iconColor="red" iconPosition="RIGHT" />
										<m:ObidosTextBox ui:field="itemNameTextBox" addStyleNames='{style.ro-font}' readOnly="true" />
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forComment" ui:field='commentLabel' addStyleNames="col-sm-4" text="{i18n.commentLabel}" />
								<g:FlowPanel addStyleNames="col-sm-4">
									<m:ObidosTextBox ui:field="revokeCommentTextBox" placeholder="{i18n.revokeContainerPlaceHolder}" enabled="true" />
								</g:FlowPanel>
							</m:ObidosRow>

							<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4">Search</b:FormLabel>
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup>
										<m:ObidosTextBox ui:field="searchTextBox" placeholder='{i18n.searchUsers}' enabled="true" />
										<b:InputGroupButton>
											<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text="" />
										</b:InputGroupButton>
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>

                            <!-- issue 659 -->
							<m:ObidosRow bottomMargin="{i18n.bottomMargin}" visible="false">
								<b:FormLabel addStyleNames="col-sm-4" text="{i18n.sendNotificationEmail}"/>
								<g:FlowPanel addStyleNames="col-sm-4">
									  <b3:ToggleSwitch ui:field="sendNotificationEmailSwitch" size="SMALL" onColor="SUCCESS" offColor="DANGER" onText="✓" offText="✗" value="false"/>
								  </g:FlowPanel>
							</m:ObidosRow>

   						   <m:ObidosMessageRow ui:field="messageRow" />

							<b:Row>
								<m:ObidosClearSelectionsButton ui:field="clearButton" />
								<m:ObidosRevokeButton ui:field="revokeButton" />
							</b:Row>
						</b:Form>

						<g:HTMLPanel>
							<b.gwt:DataGrid bordered="true" addStyleNames='{style.item-groups-datagrid}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
							<g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
									<tr>
										<td align='center'>
											<c:SimplePager ui:field='pager' />
										</td>
									</tr>
								</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.form-error-label {
	color: red;
}

.message-info {
	margin: 10px 0px;
	padding: 12px;
	color: #00529B;
	background-color: #BDE5F8;
	box-shadow: 1px 1px 3px #888;
}

.ginfo {
	background-color: #EEEEEE;
	border-color: #2F79B9;
}

.margin-fix {
	margin-top: 0 !important;
}

.paragraph-font {
	font-size: 13px;
}

.margin {
	margin: 5px;
}
.bottom-margin {
	margin-bottom: 3px;
}
</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
				<b:BlockQuote addStyleNames="{style.ginfo}" ui:field='helpBlockQuote' visible="false">
					<b.html:Paragraph ui:field='newGroupInfoParagraph' addStyleNames='{style.paragraph-font}' HTML="{i18n.createNewGroupHelp}" />
				</b:BlockQuote>
					<b:Panel type="PRIMARY">
                        <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.createNewGroup}"/>
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">
									 <!--  Language -->
									<m:ObidosRowBottom2px ui:field="languageRow">
										 <b:FormLabel for="languagel" b:id="languagel" addStyleNames="col-sm-4" HTML="{i18n.language}" />
										 <g:FlowPanel addStyleNames="col-sm-4">
											<b:ListBox b:id="languagelb" ui:field='languageListBox'>
												<g:item>English</g:item>
												<g:item>বাংলা</g:item>
											</b:ListBox>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

                                    <m:ObidosRow bottomMargin="8px">
										<b:FormLabel for="forName" ui:field='groupNameLabel' addStyleNames="col-sm-4" HTML="{i18n.groupNameLabelHtml}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
										  <m:ObidosInputGroup ui:field="groupNameInputGroup" readOnly="false" isSecure="false" placeHolder="{i18n.groupNamePlaceHolder}"/>
										</g:FlowPanel>
									</m:ObidosRow>

                                    <m:ObidosRow bottomMargin="3px">
										<b:FormLabel ui:field="groupCommentLabel" addStyleNames="col-sm-4" text="{i18n.commentLabel}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
										  <m:ObidosInputGroup ui:field="groupCommentInputGroup" readOnly="false" isSecure="false" placeHolder="{i18n.commentLabel}"/>
										</g:FlowPanel>

									</m:ObidosRow>

									<m:ObidosMessageRow ui:field="messageRow"/>

									<b:Row>
									   <m:ObidosButtonToolBar ui:field="bottomToolBar">
											<b:Button type="SUCCESS" ui:field='saveButton' text="{i18n.create}"/>
			        					    <m:ObidosResetButton ui:field='resetButton' />
										</m:ObidosButtonToolBar>
									</b:Row>
								</b:Form>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:c="urn:import:com.google.gwt.user.cellview.client"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.st-message-error{
    margin: 10px 0px;
    padding:12px;
    color: #D8000C;
    background-color: #FFBABA;
    box-shadow:1px 1px 3px #888;
}
.st-message-info{
    margin: 10px 0px;
    padding:12px;
    color: #00529B;
    background-color: #BDE5F8;
    box-shadow:1px 1px 3px #888;
}
.form-error-label{
    color: red;
}
.margin-fix {
    margin-top: 0 !important;
}
.margin {
    margin: 5px;
}
.selectTemplateDataGridCell td div{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.help-bq {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.help-paragraph-font {
    font-size: 13px;    
}
.margin-fix {
    margin-top: 0 !important;
}

.center-toolbar {
	justify-content: center;
	display: flex;
}
.sort-style {
	font-weight: bold;
}
</ui:style>

<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
	   <b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="{i18n.selectItemTypeTemplateHelp}" />
		</b:BlockQuote>
		<b:Row>
				<b:Panel type="PRIMARY">
                                        <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.selectItemTypeTemplate}" /> 
					<b:PanelBody>
						<b:Form type="HORIZONTAL">
							<b:Row>
							     <m:ObidosButtonToolBar ui:field="buttonToolBar">
									<b:Button type="SUCCESS" ui:field='selectButton' b:id="select" text="{i18n.selectTemplate}"/>
									<b:Button type="PRIMARY" ui:field='listButton' text="{i18n.listMyContainers}" visible="false" />
<!--
									<b:Button type="INFO" ui:field='helpButton' text="{i18n.helpButtonTitle}" />
-->
							     </m:ObidosButtonToolBar>
							</b:Row>
							<!--
							<b:Row>
								<b:ButtonToolBar addStyleNames="{style.center-toolbar}">
									<b:Button addStyleNames="col-sm-2" type="SUCCESS" ui:field='selectButton' text="{i18n.addItemToContainerButton}"/>
									<b:Button addStyleNames="col-sm-2" type="PRIMARY" ui:field='listButton' text="{i18n.listMyContainers}"/>
									<b:Button addStyleNames="col-sm-2" type="INFO" ui:field='helpButton' text="{i18n.helpButtonTitle}" />
								</b:ButtonToolBar>
							</b:Row>
							-->
							
							<m:ObidosMessageRow ui:field="messageRow"/>
							
							<m:ObidosRow bottomMargin="{i18n.bottomMargin}">
								<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4">Search</b:FormLabel>
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup>
									<m:ObidosTextBox ui:field="serachTextBox" placeholder="{i18n.searchTemplateName}" enabled="true"/>
									<b:InputGroupButton>
									<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text=""/>
									</b:InputGroupButton>
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>
							<b:Row>
							     <b:ButtonGroup>
								<b:Button type="LINK" icon="SORT" addStyleNames="{style.sort-style}" dataToggle="DROPDOWN" toggleCaret="false" text="{i18n.sort}" />
									<b:DropDownMenu>
										<b:AnchorListItem icon="CHEVRON_CIRCLE_DOWN" ui:field="sortByDate" text="{i18n.sortByUpdatedDate}" />
										<b:AnchorListItem icon="CHEVRON_CIRCLE_UP" ui:field="sortReverseByDate" text="{i18n.sortReverseByUpdatedDate}" />
										<b:AnchorListItem icon="SORT_ALPHA_ASC" ui:field="sortByAZ" text="{i18n.sortByTemplateAZ}" />
										<b:AnchorListItem icon="SORT_ALPHA_DESC" ui:field="sortByZA" text="{i18n.sortByTemplateZA}" />
									</b:DropDownMenu>
							     </b:ButtonGroup>
							</b:Row>

						</b:Form>

						<g:HTMLPanel>
							<b.gwt:DataGrid bordered="true" addStyleNames='{style.selectTemplateDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid"/>
							<g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
								  <tr>
									<td align='center'>
									  <c:SimplePager ui:field='pager' />
									</td>
								  </tr>
								</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

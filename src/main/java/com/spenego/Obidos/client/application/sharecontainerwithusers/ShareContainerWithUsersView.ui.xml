<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
    xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.encrypted-info {
		color: #9900ff;
	}
	
	.message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.margin {
		margin: 5px;
	}
	
	.ucontainerShareUserDataGridCell td div {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.paragraph-font {
		font-size: 13px;
	}
	
	.ginfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.bottom-margin {
		margin-bottom: 3px;
	}
	.label-font {
	   font-size: small;
	   color: #CCCCCC;
	}
	</ui:style>


	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:BlockQuote addStyleNames="{style.ginfo}" ui:field='helpBlockQuote'
				visible="false">
				<b.html:Paragraph ui:field='paragraph'
					addStyleNames='{style.paragraph-font}' HTML="{i18n.shareContainerWithUsersHelp}" />
			</b:BlockQuote>

			<b:Row>
					<b:Panel type="PRIMARY">
						<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.shareContainerWithUsers}"/>
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">
									<m:ObidosRow bottomMargin="2px">
										<b:FormLabel for="forContainerName" ui:field='containerNameLabel' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosInputGroup ui:field="nameInputGroup" readOnly="true" isSecure="false" placeHolder="" />
										</g:FlowPanel>
									</m:ObidosRow>

									<b:Row>
										<b:FormLabel for="forComment" ui:field='commentLabel' addStyleNames="col-sm-4" text="Comment" />
										<g:FlowPanel addStyleNames="col-sm-4 {style.bottom-margin}">
											<m:ObidosTextBox ui:field="shareCommentTextBox" placeholder="{i18n.sharingCommentPlaceHolder}" enabled="true" />
										</g:FlowPanel>
									</b:Row>

									<m:ObidosRow bottomMargin="2px">
										<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4" text="{i18n.searchButtonTitle}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosTextBox ui:field="serachTextBox"
													placeholder="{i18n.searchUsersToSharePlaceHolder}" enabled="true" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRow>

                                    <!-- issue 659 -->
									<m:ObidosRow bottomMargin="{i18n.bottomMargin}" visible="true">
											<b:FormLabel addStyleNames="col-sm-4" text="{i18n.sendNotificationEmail}"/>
											<g:FlowPanel addStyleNames="col-sm-2">
      										    <b3:ToggleSwitch ui:field="sendNotificationEmailSwitch" size="SMALL" onColor="SUCCESS" offColor="DANGER" onText="✓" offText="✗" value="false"/>
												<g:Label addStyleNames="{style.label-font}" ui:field="licenseLabel" visible="false"/>
  										    </g:FlowPanel>
									</m:ObidosRow>
									<m:ObidosRow bottomMargin="{i18n.bottomMargin}" visible="true">
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.sendNotificationSMS}"/>
										<g:FlowPanel addStyleNames="col-sm-2">
											  <b3:ToggleSwitch ui:field="sendNotificationSmsSwitch" size="SMALL" onColor="SUCCESS" offColor="DANGER" onText="✓" offText="✗" value="false"/>
											<g:Label addStyleNames="{style.label-font}" ui:field="licenseLabelSms" visible="false"/>
										</g:FlowPanel>
									</m:ObidosRow>

									<m:ObidosMessageRow ui:field="messageRow" />

									<b:Row>
										<m:ObidosClearSelectionsButton ui:field="clearButton" />
										<m:ObidosShareButton ui:field="shareContainerButton" tooltip="{i18n.selectUsersAndClickToShare}" />
									</b:Row>
								</b:Form>

								<b.gwt:DataGrid bordered="true" addStyleNames='{style.ucontainerShareUserDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
								<g:HTMLPanel ui:field="htmlPanel2">
									<table style="width:100%">
										<tr>
											<td align='center'>
												<c:SimplePager ui:field='pager' />
											</td>
										</tr>
									</table>
								</g:HTMLPanel>


							</g:HTMLPanel>


						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

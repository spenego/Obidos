<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
    xmlns:select="urn:import:org.gwtbootstrap3.extras.select.client.ui"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />

	<ui:style gss="true">
	.admins-management-well {
		color: #948A54;
		background: #C3E4ED;
		font-weight: bold;
		overflow: auto;
		margin-bottom: 0;
	}
	
	.users-management-well {
		color: #948A54;
		background: #CFC9A7;
		font-weight: bold;
		overflow: auto;
		margin-bottom: 0;
	}
	
	.settings-management-well {
		color: #948A54;
		background: #ABFBBD;
		font-weight: bold;
		overflow: auto;
		margin-bottom: 0;
	}
	
	.console-top-margin {
		margin-top: 20px;
	}
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.userConsole}"/>
					<b:PanelBody ui:field="panelBody">
						<b:Container fluid="true">
							<b:Row>
								<b:Column size="MD_4">
									<b:Well addStyleNames='{style.admins-management-well}'>
										<b.html:Span text="{i18n.manageNotes}" />
										<b.html:Span>
											<br />
											<ul>
												<li>
													<b.html:Span text="{i18n.createNotes}" />
												</li>
												<li>
													<b.html:Span text="{i18n.modifyNotes}" />
												</li>
												<li>
													<b.html:Span text="{i18n.viewNotes}" />
												</li>
												<li>
													<b.html:Span text="{i18n.shareNotes}" />
												</li>
												<br/>
											</ul>
										</b.html:Span>
									</b:Well>
								</b:Column>

								<b:Column size="MD_4">
									<b:Well addStyleNames='{style.users-management-well}'>
										<b.html:Span text="{i18n.mangeContainers}" />
										<b.html:Span>
											<ul>
												<li>
													<b.html:Span text="{i18n.createShareableAndPrivateContainers}" />
												</li>
												<li>
													<b.html:Span text="{i18n.modifyContainers}" />
												</li>
												<li>
													<b.html:Span text="{i18n.createItemInContainers}" />
												</li>
												<li>
													<b.html:Span text="{i18n.shareContainersItems}" />
												</li>
											</ul>
										</b.html:Span>
									</b:Well>
								</b:Column>

								<b:Column size="MD_4">
									<b:Well addStyleNames='{style.settings-management-well}'>
										<b.html:Span text="{i18n.manageGroupsAndTemplates}" />
										<b.html:Span>
											<br />
											<ul>
												<li>
													<b.html:Span text="{i18n.createPersonalGroups}" />
												</li>
												<li>
													<b.html:Span text="{i18n.personalGlobalTemplates}" />
												</li>
												<li>
													<b.html:Span text="{i18n.listTemplatesGroups}" />
												</li>
												<li>
													<b.html:Span text="{i18n.configure2FA}" />
												</li>
											</ul>
                                            <br/>
										</b.html:Span>
									</b:Well>

								</b:Column>
							</b:Row>

							<m:ObidosRowTop2px ui:field='changeLanguageRow'>
    							<g:FlowPanel addStyleNames="col-sm-4">
									<select:Select title="Change Language" ui:field="languageChangeSelect">
									  <select:Option text="English"/>
									  <select:Option text="Arabic"/>
									  <select:Option text="Bangla"/>
									  <select:Option text="German"/>
									  <select:Option text="Hindi"/>
									  <select:Option text="Japanese"/>
									  <select:Option text="Malayalam"/>
									</select:Select>
    							</g:FlowPanel>
                            </m:ObidosRowTop2px>
							
						</b:Container>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>
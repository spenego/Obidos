<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:c="urn:import:com.google.gwt.user.cellview.client"
             xmlns:summer="urn:import:com.spenego.Obidos.client.application.widgets.summernote"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.form-error-label{
    color: red;
}
.margin-fix {
    margin-top: 0 !important;
}
.margin {
    margin: 5px;
}
.litemUsersDataGridCell td div{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.item-help-bq {
background-color:  #EEEEEE;
border-color: #2F79B9;
}
.item-help-paragraph-font {
    font-size: 13px;    
}

.center-toolbar {
	justify-content: center;
	display: flex;
}

	.button-margin {
	   margin-left: 15px !important;   
	   margin-bottom: 1px;
	}
	.bottom-margin {
	   margin-bottom: 2px;
	}
</ui:style>

<!--
*********************************************************************
This is the UI for listing the users to whom an Item is shared.
*********************************************************************
-->

<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
	   <b:BlockQuote addStyleNames="{style.item-help-bq}" ui:field='helpBlockQuote' visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.item-help-paragraph-font}' HTML="{i18n.listOfUsersItemIsSharedWithHelp}"/>
		</b:BlockQuote>
		<b:Row>
				<b:Panel type="PRIMARY">
			        <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.listMyNotes}"/>
					<b:PanelBody>
						<b:Form type="HORIZONTAL">
							<b:Row ui:field="containerNameRow" addStyleNames="{style.bottom-margin}">
								<b:FormLabel ui:field='containerNameLabel' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}"/>
								<g:FlowPanel addStyleNames="col-sm-4">
									<m:ObidosInputGroup ui:field="containerNameInputGroup" readOnly="true" isSecure="false" placeHolder=""/>
								</g:FlowPanel>
							</b:Row>
    						<m:ObidosRow bottomMargin="2px">
								<b:FormLabel for="forNoteName" ui:field='itemNameLabel' addStyleNames="col-sm-4" text="{i18n.itemNameLabel}"/>
								<g:FlowPanel addStyleNames="col-sm-4">
									<m:ObidosInputGroup ui:field="nameInputGroup" readOnly="true" isSecure="false" placeHolder=""/>
								</g:FlowPanel>
							</m:ObidosRow>
							<m:ObidosRow bottomMargin="{i18n.bottomMargin}">
								<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4">Search</b:FormLabel>
								<g:FlowPanel addStyleNames="col-sm-4">
									<b:InputGroup>
										<m:ObidosTextBox ui:field="searchTextBox" placeholder='{i18n.searchUsers}' enabled="true"/>
										<b:InputGroupButton>
											<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text=""/>
										</b:InputGroupButton>
									</b:InputGroup>
								</g:FlowPanel>
							</m:ObidosRow>
							<m:ObidosMessageRow ui:field="messageRow"/>
							
<!--
							<b:Row>
    							<m:ObidosLinkBackButton ui:field="listButton"/>
							</b:Row>
-->
						</b:Form>

						<g:HTMLPanel>
							<b.gwt:DataGrid bordered="true" addStyleNames='{style.litemUsersDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid"/>
							<g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
								  <tr>
									<td align='center'>
									  <c:SimplePager ui:field='pager' />
									</td>
								  </tr>
								</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
				    </b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.height {
		height: 15px;
	}
	
	.paragraph-font {
		font-size: 13px;
	}
	
	.info {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.create-ldap-panel-header {
		background-color: #222222 !important;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	
	.center-label {
		text-align: center;
	}
	.top-margin {
	   margin-top: 5px;
	}
    /* https://www.w3schools.com/howto/tryit.asp?filename=tryhow_css_loader */
    /* I seem to like this one better */
    .loading {
        display: inline-flex;
        align-items: center;
        margin-left: 0px; 
        position: relative; 
        top: 10px !important; 
        /* position: absolute; */
        /*margin-left: 4px;*/
        /*top: 50%;*/
        /* left: 65%; */
    }
    .loader {
      border: 2px solid #f3f3f3;
      border-radius: 50%;
      /* border-top: 2px solid #3498db; */
      border-top: 2px solid #9900ff;
      width: 16px;
      height: 16px;
      -webkit-animation: spin 2s linear infinite; /* Safari */
      animation: spin 2s linear infinite;
    }

	</ui:style>
	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.info}" ui:field="helpBlockQuote">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.paragraph-font}' HTML="TODO" />
			</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true"
						headerText="{i18n.ldapPanelHeading}" />
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">
								<b:FormGroup>
									<m:ObidosRowBottom2px>
										<b:FormLabel for="forConfigName" ui:field='configNameLabel'
											addStyleNames="col-sm-4" HTML="{i18n.ldapConfigurationNameHtml}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="configNameTextBox"
												placeholder="{i18n.ldapConfigurationNamePlaceHolder}" allowBlank="false" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="forLdapUri" ui:field='ldapUriLabel' addStyleNames="col-sm-4" HTML="{i18n.ldapUriHtml}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="uriTextBox" placeholder="{i18n.ldapUriPlaceHolder}" allowBlank="false" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

                                    <!-- StartTLS -->
									<m:ObidosRowBottom2px>
										<b:FormLabel for="forStartTLS" ui:field='startTLSLabel' addStyleNames="col-sm-4" HTML="{i18n.enableStartTLS}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											  <b:CheckBox ui:field="startTLSCheckBox" text=""/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="forBaseDn" ui:field='baseDnLabel' addStyleNames="col-sm-4" HTML="{i18n.baseDnHtml}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="basednTextBox" placeholder="{i18n.baseDnPlaceHolder}" allowBlank="false" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="forBindDn" ui:field='bindDnLabel' addStyleNames="col-sm-4" text="{i18n.bindDn}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="binddnTextBox" placeholder="{i18n.bindDn}" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="forBindBass" ui:field='bindPasswordLabel' addStyleNames="col-sm-4" text="{i18n.bindPassword}" />
										<g:FlowPanel addStyleNames="col-sm-4" ui:field='bindPassFlowPanel'>
											<b:InputGroup ui:field='bindPassInputGroup'>
												<m:ObidosPasswordBox ui:field="bindpassTextBox" placeholder="{i18n.bindPassword}" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHideBindPassButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="forAuthAttr" ui:field='authAttrLabel'
											addStyleNames="col-sm-4" HTML="{i18n.authAttributeHtml}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="authAttrTextBox"
												placeholder="Auth Attribue (required)" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosMessageRow ui:field="messageRow" />

									<b:Row>
										<m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
											<b:Button type="SUCCESS" ui:field='saveButton'
												text="{i18n.saveButtonTitle}" />
											<m:ObidosResetButton ui:field='resetButton' />
										</m:ObidosButtonToolBar>
									</b:Row>

									<b:Row>
										<b:Row>
											<g:FlowPanel addStyleNames="{style.center-label}">
												<b:FormLabel text="{i18n.testConnectionAuthentication}"/>
											</g:FlowPanel>
										</b:Row>

										<m:ObidosRowBottom2px>
											<b:FormLabel for="testFromAddress" addStyleNames="col-sm-4" text="{i18n.username}"/>
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field='testUsernameTextBox' placeholder="{i18n.username}"/>
											</g:FlowPanel>
										</m:ObidosRowBottom2px>

										<m:ObidosRowBottom2px>
											<b:FormLabel for="forBindBass" addStyleNames="col-sm-4" text="{i18n.password}"/>
											<g:FlowPanel addStyleNames="col-sm-4">
												<b:InputGroup ui:field='testPassInputGroup'>
													<m:ObidosPasswordBox ui:field="testPasswordBox" placeholder="{i18n.password}" />
													<b:InputGroupButton>
														<b:Button type="INFO" icon="EYE" ui:field='showHideTestPassButton' text="" />
													</b:InputGroupButton>
												</b:InputGroup>
											</g:FlowPanel>
											<!--  circular busy icon -->
											<g:HTMLPanel ui:field="processingPanel" addStyleNames="{style.loading}" visible="false">
											  <span class="{style.loader}"></span>
											</g:HTMLPanel>
										</m:ObidosRowBottom2px>
									</b:Row>
									<m:ObidosMessageRow ui:field="testMessageRow" addStyleNames="{style.top-margin}"/>
									<b:Row>
										<m:ObidosButtonToolBar ui:field="buttonToolBarTest">
											<b:Button type="PRIMARY" ui:field='testConnectionButton' text="{i18n.testConnection}" />
											<b:Button type="PRIMARY" ui:field='testAuthenticationButton' text="{i18n.testAuthentication}"/>
										</m:ObidosButtonToolBar>
									</b:Row>

								</b:FormGroup>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

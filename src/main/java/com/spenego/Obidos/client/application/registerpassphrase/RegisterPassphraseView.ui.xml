<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />

	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.rinfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.paragraph-font {
		font-size: 13px;
	}
	
	.rmargin-fix {
		margin-top: 0 !important;
	}
	</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.rinfo}" ui:field="helpBlockQuote" visible="false">
				<b.html:Paragraph ui:field='passphraseParagraph' addStyleNames='{style.paragraph-font}' />
			</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader"
						showBackButton="false" headerText="{i18n.enterPassphrase}" />
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">

								<m:ObidosRowBottom3px>
									<b:FormLabel for="forSystemName" ui:field='systemNameLabel' addStyleNames="col-sm-4" text="{i18n.registerPassphraseLabel}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<b:InputGroup>
											<m:ObidosPasswordBox b:id="passphrase" ui:field="passphraseBox" placeholder="{i18n.registerPassphraseTextPlaceHolder}" />
											<b:InputGroupButton>
												<b:Button type="INFO" icon="EYE" ui:field='showHidePassphrasedButton' text="" />
											</b:InputGroupButton>
										</b:InputGroup>
									</g:FlowPanel>
								</m:ObidosRowBottom3px>

								<m:ObidosMessageRow ui:field="messageRow" />

								<b:Row>
									<m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
										<b:Button type="SUCCESS" b:id="submit" ui:field='submitButton' icon="ARROW_RIGHT" iconPosition="RIGHT" text="{i18n.registerPassphraseSubmitButton}" />
										<b:Button type="PRIMARY" b:id="later" ui:field='laterButton' text="{i18n.registerPassphraseLaterButton}" visible="false" />
									</m:ObidosButtonToolBar>
								</b:Row>

							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

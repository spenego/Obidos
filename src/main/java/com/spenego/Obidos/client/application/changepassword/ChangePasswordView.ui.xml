<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
    xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.passwordStrengthLabel {
		font-size: 10px;
		line-height: normal;
	}
	
	.passwordStrengthBar {
		height: 15px;
		line-height: 15px;
		font-size: 10px;
	}
	
	.suggestionListColor {
		color: #009999;
	}

	.top-margin {
	   margin-top: 5px;
    }
	.cp-help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.cp-help-paragraph-font {
		font-size: 13px;
	}
	
	.cp-panel-header {
		background-color: #222222 !important;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	
	.progress-margin {
		margin-bottom: 0px !important;
	}
	
	.progress-height {
		font-size: 0.9em;
		line-height: 1 !important;
	}
	
	.progress-left-padding {
		padding-left: 0px !important;
	}
	.top-margin {
	   margin-top: 10px !important;
	}
    /* https://www.w3schools.com/howto/tryit.asp?filename=tryhow_css_loader */
    /* I seem to like this one better */
    .loading {
        display: inline-flex;
        align-items: center;
        margin-left: 0px; 
        position: relative; 
        top: 10px !important; 
        /* position: absolute; */
        /*margin-left: 4px;*/
        /*top: 50%;*/
        /* left: 65%; */
    }
    .loader {
      border: 2px solid #f3f3f3;
      border-radius: 50%;
      /* border-top: 2px solid #3498db; */
      border-top: 2px solid #9900ff;
      width: 16px;
      height: 16px;
      -webkit-animation: spin 2s linear infinite; /* Safari */
      animation: spin 2s linear infinite;
    }

    /* Safari */
    @-webkit-keyframes spin {
      0% { -webkit-transform: rotate(0deg); }
      100% { -webkit-transform: rotate(360deg); }
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
				<b:Row>
				<b:BlockQuote addStyleNames="{style.cp-help-bq}" ui:field='helpBlockQuote' visible="false">
					<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.cp-help-paragraph-font}' HTML="{i18n.changePasswordHelp}" />
				</b:BlockQuote>
					<b:Panel type="PRIMARY">
						<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.changePassword}" />
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL" ui:field='suggestionForm'>
									<b:Row>
										<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
											<b.html:Strong text="{i18n.resetPasswordsuggestionForStringPassword}" />
											<b:ListGroup addStyleNames='{style.suggestionListColor}'>
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp1}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp2}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp3}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp4}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp5}" type="DEFAULT" />
											</b:ListGroup>
										</g:FlowPanel>
									</b:Row>

									<b:Row>
										<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
											<b.html:Strong text="{i18n.passwordRequirementsLabel}" />
											<b:ListGroup ui:field='passwordRequirementListGroup'>
												<b:ListGroupItem HTML="{i18n.passwordRequirementHelp1}" type="DEFAULT" />
											</b:ListGroup>
										</g:FlowPanel>
									</b:Row>


									<m:ObidosRow bottomMargin="2px">
										<b:FormLabel for="forCurrentassword" addStyleNames="col-sm-4" text="{i18n.currentPassword}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosPasswordBox ui:field="oldPasswordBox" placeholder="{i18n.currentPassword}" allowBlank="false" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHideCurrentPasswordButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
										<g:HTMLPanel ui:field="processingPanel" addStyleNames="{style.loading}" visible="false">
										  <span class="{style.loader}"></span>
										</g:HTMLPanel>
									</m:ObidosRow>

									<m:ObidosRowBottom2px>
										<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-4">
											<b:Label ui:field="ncharsLabel" text="0" type="DEFAULT" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRow bottomMargin="2px">
										<b:FormLabel for="forNewPassword" addStyleNames="col-sm-4" text="{i18n.newPassword}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosPasswordBox ui:field="newPasswordBox" placeholder="{i18n.newPassword}" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHideNewPasswordButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
										<g:FlowPanel addStyleNames="col-sm-4 {style.progress-left-padding}">
											<g:Label ui:field='passwordStrengthLabel' addStyleNames="pl-0 ml-0 {style.progress-height}" text="{i18n.passwordStrength}" />
											<b:Progress ui:field='passwordStrengthProgress'
												addStyleNames="pl-0 ml-0 {style.progress-margin}">
												<b:ProgressBar ui:field='passwordStrengthBar' type="DANGER" percent="25" text="weak" />
											</b:Progress>
										</g:FlowPanel>
									</m:ObidosRow>

                                    <m:ObidosRowTop2px>
										<b:FormLabel for="forConfirmPassword" addStyleNames="col-sm-4" text="{i18n.confirmPassword}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosPasswordBox ui:field="confirmNewPasswordBox" placeholder="{i18n.confirmNewPassword}" allowBlank="false" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHideConfirmPasswordButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowTop2px>
										<!-- 2FA stuff  -->
										<!-- we don't enforce 2FA for password change yet, hide it for now -->
										<b:Row ui:field="twofarow" visible="false">
											<g:FlowPanel ui:field='require2faFp' addStyleNames="col-sm-12 {style.top-margin}">
												<b:Row>
													<b:FormLabel ui:field="requiresTwoFAPasswordResetLabel" addStyleNames="col-sm-4" text="{i18n.requires2FA}"/>
													<g:FlowPanel addStyleNames="col-sm-4">
														 <b3:ToggleSwitch ui:field='requiresTwoFAPasswordResetSwitch' size="SMALL" onText="Yes" offText="No" value="true" readOnly="true"/>
													</g:FlowPanel>
												</b:Row>

                                                <b:Row ui:field="twofaCodeRow">
													<b:Row>
														<g:FlowPanel ui:field="badge1Flow" addStyleNames="col-sm-offset-4 col-sm-8 {style.top-margin}">
															<g:HTMLPanel>
																<g:HTML HTML="{i18n.getVerificationCode}"/>
															</g:HTMLPanel>
														</g:FlowPanel>
													</b:Row>

													<b:Row>
														<b:FormLabel for="forPassword" addStyleNames="col-sm-4" text="{i18n.enterVaidationCodeLabel}"/>
														<g:FlowPanel addStyleNames="col-sm-4">
														   <m:ObidosTextBox ui:field='twofaCodeBox' placeholder="{i18n.enterValidationCodeFromGoogleAuthenticator}"/>
														</g:FlowPanel>
													</b:Row>
												</b:Row>
											</g:FlowPanel>
										</b:Row>

									<m:ObidosMessageRow addStyleNames="{style.top-margin}" ui:field="messageRow" />

									<m:ObidosRow bottomMargin="2px">
										<b:ButtonToolBar addStyleNames="{style.center-toolbar}">
											<b:Button type="SUCCESS" ui:field='changePasswordButton' text="{i18n.changePassword}" />
										</b:ButtonToolBar>
									</m:ObidosRow>
									<m:ObidosRow bottomMargin="2px">
									   <g:FlowPanel addStyleNames="col text-center">
											<b:Button type="DANGER" ui:field='hibpButton' text="{i18n.checkCompromisedList}" visible="true"/>
										</g:FlowPanel>
									</m:ObidosRow>
								</b:Form>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
				</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
    xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />

	<ui:style gss="true">
	.smtpDataGridCell td div {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	
	.list-smtp-panel-header {
		background-color: #222 !important;
	}
	
	.info {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.paragraph-font {
		font-size: 13px;
	}
	</ui:style>
	<g:HTMLPanel>
	   <b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.info}" ui:field="helpBlockQuote" visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.paragraph-font}' HTML="{i18n.smtpSettingsHelp}"/>
			</b:BlockQuote>
					<b:Panel type="PRIMARY">
					    <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" addStyleNames="{style.list-smtp-panel-header}" headerText="{i18n.listSMTPSettings}"/>
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">
								    <m:ObidosMessageRow ui:field="messageRow"/>
								</b:Form>
								<b.gwt:DataGrid addStyleNames='{style.smtpDataGridCell}' bordered="true" condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
								<g:HTMLPanel ui:field="htmlPanel">
									<table style="width:100%">
										<tr>
											<td align='center'>
												<c:SimplePager ui:field='pager' />
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>    
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.ldapDataGridCell td div {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	
	.message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.message-error {
		margin: 10px 0px;
		padding: 12px;
		color: #D8000C;
		background-color: #FFBABA;
		box-shadow: 1px 1px 3px #888;
	}
	
	.list-ldap-panel-header {
		background-color: #222222 !important;
	}
	
	.ldap-help-bg {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.ldap-help-paragraph-font {
		font-size: 13px;
	}
	</ui:style>
	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.ldap-help-bg}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.ldap-help-paragraph-font}' HTML="{i18n.listADLDAPSettingsHelp}" />
			</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.listADLDAPSettings}"/>
					<b:PanelBody>
						<b:Form type="HORIZONTAL">
							<m:ObidosMessageRow ui:field="messageRow" />
						</b:Form>


						<b.gwt:DataGrid addStyleNames='{style.ldapDataGridCell}'
							bordered="true" condensed="true" striped="true" hover="true" width="100%"
							ui:field="dataGrid" />
						<g:HTMLPanel ui:field="htmlPanel">
							<table style="width:100%">
								<tr>
									<td align='center'>
										<c:SimplePager ui:field='pager' />
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

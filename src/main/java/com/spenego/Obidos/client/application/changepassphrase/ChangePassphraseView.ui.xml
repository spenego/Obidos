<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.ymessage-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.yrinfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.paragraph-font {
		font-size: 13px;
	}
	
	.yrmargin-fix {
		margin-top: 0 !important;
	}
	
	.progress-margin {
		margin-bottom: 0px !important;
	}
	
	.progress-height {
		font-size: 0.9em;
		line-height: 1 !important;
	}
	.progress-left-padding {
		padding-left: 0px !important;
	}
    /* https://www.w3schools.com/howto/tryit.asp?filename=tryhow_css_loader */
    /* I seem to like this one better */
    .loading {
        display: inline-flex;
        align-items: center;
        margin-left: 0px; 
        position: relative; 
        top: 10px !important; 
        /* position: absolute; */
        /*margin-left: 4px;*/
        /*top: 50%;*/
        /* left: 65%; */
    }
    .loader {
      border: 2px solid #f3f3f3;
      border-radius: 50%;
      /* border-top: 2px solid #3498db; */
      border-top: 2px solid #9900ff;
      width: 16px;
      height: 16px;
      -webkit-animation: spin 2s linear infinite; /* Safari */
      animation: spin 2s linear infinite;
    }

    /* Safari */
    @-webkit-keyframes spin {
      0% { -webkit-transform: rotate(0deg); }
      100% { -webkit-transform: rotate(360deg); }
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
	</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:BlockQuote addStyleNames="{style.yrinfo}" ui:field="helpBlockQuote" visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.paragraph-font}' HTML="{i18n.changePassphraseHelp}" />
			</b:BlockQuote>
			<b:Row>
				<b:Column size="XS_12">
					<b:Panel type="PRIMARY">
    					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.changePassphrase}"/>
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">

									<b:Row>
										<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
											<b.html:Strong text="{i18n.keyPairSuggestionsForStringPassphrase}" />
											<b:ListGroup>
												<b:ListGroupItem HTML="{i18n.keyPairStrongPassphraseHelp1}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.keyPairStrongPassphraseHelp2}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.keyPairStrongPassphraseHelp3}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp5}" type="DEFAULT"/>
											</b:ListGroup>
										</g:FlowPanel>
									</b:Row>

									<b:Row>
										<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
											<b.html:Strong HTML="{i18n.passphraseRequirementsLabel}"/>
											<b:ListGroup ui:field='passphraseRequirementListGroup'/>
										</g:FlowPanel>
									</b:Row>


									<m:ObidosRowBottom2px>
										<b:FormLabel for="forCurrentPassphraseLabel" ui:field='currentPassphraseLabel' addStyleNames="col-sm-4" text="{i18n.currentPassphrase}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosPasswordBox ui:field="currentPassphraseBox"
													placeholder="{i18n.currentPassphrase}" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHideCurrentPassphrasedButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
										<g:HTMLPanel ui:field="processingPanel" addStyleNames="{style.loading}" visible="false">
										  <span class="{style.loader}"></span>
										</g:HTMLPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-4">
											<b:Label ui:field="ncharsLabel" text="0" type="DEFAULT" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="forNewPassphraseLabel" ui:field='newPassphraseLabel' addStyleNames="col-sm-4" text="{i18n.newPassphrase}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosPasswordBox ui:field="newPassphraseBox" placeholder="{i18n.newPassphrase}" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHideNewPassphrasedButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>

										</g:FlowPanel>
										<g:FlowPanel addStyleNames="col-sm-4 {style.progress-left-padding}">
											<g:Label ui:field='passphraseStrengthLabel' addStyleNames="pl-0 ml-0 {style.progress-height}" text="{i18n.passphraseStrength}" />
											<b:Progress addStyleNames="pl-0 ml-0 {style.progress-margin}" ui:field='passphraseStrengthProgress'>
												<b:ProgressBar ui:field='passphraseStrengthBar' type="DANGER" percent="25" text="{i18n.weak}" />
											</b:Progress>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>
									<m:ObidosRowBottom2px>
										<b:FormLabel for="forRepeatPassphraseLabel" ui:field='repeatPassphraseLabel' addStyleNames="col-sm-4" text="{i18n.confirmPassphrase}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosPasswordBox ui:field="repeatPassphraseBox" placeholder="{i18n.confirmPassphrase}" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHideRepeatPassphrasedButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosMessageRow ui:field="messageRow" />

									<b:Row>
										<m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
											<b:Button type="SUCCESS" ui:field='changePassphraseButton'
												text="{i18n.changePassphrase}" />
										</m:ObidosButtonToolBar>
									</b:Row>
								</b:Form>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
				</b:Column>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

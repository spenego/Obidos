<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.item-message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.item-message-error {
		margin: 10px 10px;
		padding: 12px;
		color: #D8000C;
		background-color: #FFBABA;
		box-shadow: 1px 1px 3px #888;
	}
	
	.item-data-grid-cell td div {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.form-error-label {
		color: red;
	}
	
	.item-ginfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}

    .sort-style {
        font-weight: bold !important;
     }

	.margin-fix {
		margin-top: 0 !important;
	}
	
	.item-paragraph-font {
		font-size: 13px;
	}
	.ro-font {
	   color:black;
	   font-weight:bold;
	}
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	.bottom-margin {
	   margin-bottom: 3px;
	}
	.button-margin {
	   margin-left: 5px;
	   margin-right: 5px;
	}
	</ui:style>

	<g:HTMLPanel ui:field="mhtmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:BlockQuote addStyleNames="{style.item-ginfo}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.item-paragraph-font}' HTML="{i18n.listItemsAddHelp}"/>
			</b:BlockQuote>
			<b:Row>
					<b:Panel type="PRIMARY">
                        <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.listOfItemsInContainer}"/>
						<b:PanelBody>
							<b:Form type="HORIZONTAL">
									<m:ObidosRowBottom2px ui:field="containerNameRow">
										<b:FormLabel ui:field='containerNameLabel' addStyleNames="col-sm-4" text="{i18n.containerNameLabel}" />
										<g:FlowPanel addStyleNames="col-sm-5">
											<b:InputGroup ui:field='containerNameInputGroup'>
												<b:InputGroupAddon icon="UNLOCK" iconColor="{i18n.unlockColor}" iconPosition="LEFT" title="{i18n.notEncrypted}" />
												<m:ObidosTextBox ui:field="containerNameTextBox" addStyleNames='{style.ro-font}' readOnly="true" />
												<m:ObidosInputGroupAddon ui:field="containerTypeAddon"/>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

								    <m:ObidosRow bottomMargin="{i18n.bottomMargin}">
										<b:FormLabel for="forSearchLabel" ui:field='searchLabel' addStyleNames="col-sm-4" text="{i18n.search}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosTextBox ui:field="searchTextBox" placeholder="{i18n.searchItemName}" enabled="true" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="SEARCH" ui:field='searchButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRow>
    								<m:ObidosMessageRow ui:field="messageRow"/>
									<b:Row>
										<b:ButtonGroup>
												<b:Button type="LINK" icon="SORT" addStyleNames="{style.sort-style}" dataToggle="DROPDOWN" toggleCaret="false" text="{i18n.sort}" />
												<b:DropDownMenu>
													<b:AnchorListItem icon="CHEVRON_CIRCLE_DOWN" ui:field="sortByDate" text="{i18n.sortByUpdatedDate}" />
													<b:AnchorListItem icon="CHEVRON_CIRCLE_UP" ui:field="sortReverseByDate" text="{i18n.sortReverseByUpdatedDate}" />
													<b:AnchorListItem icon="SORT_ALPHA_ASC" ui:field="sortByAZ" text="{i18n.sortByItemAZ}" />
													<b:AnchorListItem icon="SORT_ALPHA_DESC" ui:field="sortByZA" text="{i18n.sortByItemZA}" />
												 </b:DropDownMenu>
										</b:ButtonGroup>
										<m:ObidosAddButton ui:field="newItemButton"/>
									</b:Row>
							</b:Form>

							<g:HTMLPanel>
								<b.gwt:DataGrid addStyleNames='{style.item-data-grid-cell}' bordered="true" condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
								<g:HTMLPanel ui:field="htmlPanel">
									<table style="width:100%">
										<tr>
											<td align='center'>
												<c:SimplePager ui:field='pager' />
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

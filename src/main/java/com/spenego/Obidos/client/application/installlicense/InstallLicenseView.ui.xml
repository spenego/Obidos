<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:select="urn:import:org.gwtbootstrap3.extras.select.client.ui"
             xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
             xmlns:d="urn:import:com.spenego.Obidos.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.margin-fix{
    margin-top: 0 !important;
}
.paragraph-font {
    font-size: 13px;    
}
.fp-bottom-margin {
    margin-bottom: 5px;
}
.top-margin {
	margin-top: 2%;
}
.info{
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.readonly-font{
	color: black;
	font-weight: bold;
}
.admin-panel-header {
	background-color: #222 !important;
}
.shr{
	border-bottom: 1px solid #ccc;
	padding-bottom: 10px;
	margin-bottom: 10px;
}
.textarea-size {
	height: 250px !important;
	font-family: monospace;
	font-size: small
}
</ui:style>
<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
		<b:Row>
		<b:BlockQuote addStyleNames="{style.info}" ui:field="helpBlockQuote" visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.paragraph-font}' HTML="{i18n.installLicenseHelp}"/>
		</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" addStyleNames="{style.admin-panel-header}" showBackButton="false" headerText="{i18n.installLicense}"/>
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">
								<b:FormGroup>
								   
                                    <m:ObidosRow bottomMargin="2%">
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.pasteLicense}"/>
										<g:FlowPanel addStyleNames="col-sm-6">
										  <m:ObidosTextArea ui:field="licenseTextArea" addStyleNames="{style.textarea-size}" maxLength="0" placeholder="{i18n.pasteLicensePlaceholder}"/>
										</g:FlowPanel>
									</m:ObidosRow>

								   <m:ObidosMessageRow addStyleNames="col-sm-offset-2" ui:field="messageRow"/>

									<b:Row addStyleNames="{style.top-margin}">
									   <m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
											<b:Button type="SUCCESS" ui:field='submitButton' text="{i18n.install}"/>
											<b:Button type="PRIMARY" ui:field='clearButton' text="{i18n.clear}"/>
									   </m:ObidosButtonToolBar>
									</b:Row>
								</b:FormGroup>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.notesGridCell td div {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	
	.notes-message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.notes-message-error {
		margin: 10px 0px;
		padding: 12px;
		color: #D8000C;
		background-color: #FFBABA;
		box-shadow: 1px 1px 3px #888;
	}
	
	.cont-help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.cont-help-paragraph-font {
		font-size: 13px;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	
	.message-label {
		cursor: pointer;
		background-color: transparent;
		color: green;
	}
	
	.bottom-margin {
		margin-bottom: 5px;
	}
	
	.sort-style {
		font-weight: bold;
	}
	.admin-panel-header {
        background-color: #222 !important;
    }
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.cont-help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.cont-help-paragraph-font}' HTML="{i18n.listNotesHelp}" />
			</b:BlockQuote>
			<b:Panel type="PRIMARY">
				<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" addStyleNames="{style.admin-panel-header}" headerText="{i18n.viewCertificates}"/>
				<b:PanelBody>
					<b:Form type="HORIZONTAL">
						<b:Row addStyleNames="{style.bottom-margin}">
							<b:NavTabs>
							  <b:AnchorListItem ui:field="obidosCertsAli" active="true" text="Obidos Certificates"/>
							  <b:AnchorListItem ui:field="adldapCertsAli" text="AD/LDAP Certificates"/>
							</b:NavTabs>
						</b:Row>
						
						<m:ObidosMessageRow ui:field="messageRow" />

						<b:Row>
						  <g:HTMLPanel ui:field="certHtmlPanel">
						      <g:HTML ui:field="certHtml"/>
						  </g:HTMLPanel>
						</b:Row>

					</b:Form>

				</b:PanelBody>
			</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.notesGridCell td div {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	
	.notes-message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.notes-message-error {
		margin: 10px 0px;
		padding: 12px;
		color: #D8000C;
		background-color: #FFBABA;
		box-shadow: 1px 1px 3px #888;
	}
	
	.cont-help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.cont-help-paragraph-font {
		font-size: 13px;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	
	.bottom-margin {
		margin-bottom: 3px;
	}
	
	.message-label {
		cursor: pointer;
		background-color: transparent;
		color: green;
	}
	
	.button-margin {
		margin-left: 5px;
	}
	
	.sort-style {
		font-weight: bold;
	}
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.cont-help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.cont-help-paragraph-font}' HTML="{i18n.listNotesHelp}" />
			</b:BlockQuote>
			<b:Panel type="PRIMARY">
				<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.listMyNotes}"/>
				<b:PanelBody>
					<b:Form type="HORIZONTAL">
						 <!--  Language -->
						<m:ObidosRowBottom2px ui:field="languageRow">
							 <b:FormLabel for="languagel" b:id="languagel" addStyleNames="col-sm-4" HTML="{i18n.language}" />
							 <g:FlowPanel addStyleNames="col-sm-4">
								<b:ListBox b:id="languagelb" ui:field='languageListBox'>
									<g:item>English</g:item>
									<g:item>বাংলা</g:item>
								</b:ListBox>
							</g:FlowPanel>
						</m:ObidosRowBottom2px>

						<b:Row addStyleNames="{style.bottom-margin}">
							<b:FormLabel for="forSearchName" addStyleNames="col-sm-4" text="{i18n.search}" />
							<g:FlowPanel addStyleNames="col-sm-4">
								<b:InputGroup>
									<m:ObidosTextBox ui:field='searchTextBox' placeholder="{i18n.searchNoteName}" />
									<b:InputGroupButton>
										<b:Button ui:field="searchButton" type="PRIMARY" icon="SEARCH" />
									</b:InputGroupButton>
								</b:InputGroup>
							</g:FlowPanel>
						</b:Row>

						<m:ObidosMessageRow ui:field="messageRow" />

						<b:Row>
							<m:ObidosClearSelectionsButton ui:field="clearButton" />
							<m:ObidosDeleteButton ui:field="deleteButton" />
							<b:ButtonGroup>
								<b:Button type="LINK" icon="SORT" addStyleNames="{style.sort-style}" dataToggle="DROPDOWN" toggleCaret="false" text="{i18n.sort}" />
								<b:DropDownMenu>
									<b:AnchorListItem icon="CHEVRON_CIRCLE_DOWN" ui:field="sortByDate" text="{i18n.sortByUpdatedDate}" />
									<b:AnchorListItem icon="CHEVRON_CIRCLE_UP" ui:field="sortReverseByDate" text="{i18n.sortReverseByUpdatedDate}" />
									<b:AnchorListItem icon="SORT_ALPHA_ASC" ui:field="sortByAZ" text="{i18n.sortByNoteAZ}" />
									<b:AnchorListItem icon="SORT_ALPHA_DESC" ui:field="sortByZA" text="{i18n.sortByNoteZA}" />
								</b:DropDownMenu>
							</b:ButtonGroup>
						</b:Row>
					</b:Form>

					<b.gwt:DataGrid addStyleNames='{style.notesGridCell}' bordered="true"
						condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
					<g:HTMLPanel ui:field="htmlPanel">
						<table style="width:100%">
							<tr>
								<td align='center'>
									<c:SimplePager ui:field='pager' />
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</b:PanelBody>
			</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

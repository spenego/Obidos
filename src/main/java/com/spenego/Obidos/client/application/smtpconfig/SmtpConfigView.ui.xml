<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />

	<ui:style gss="true">
	.info {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.form-error-label {
		color: red;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.paragraph-font {
		font-size: 13px;
	}
	
	.panel-header-bg-color {
		background-color: #222 !important;
	}
	
	.suhr {
		border-bottom: 1px solid #ccc;
		padding-bottom: 10px;
		margin-bottom: 10px;
	}
	
	.center-label {
		text-align: center;
	}
	</ui:style>

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.info}" ui:field="helpBlockQuote">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.paragraph-font}' HTML="{i18n.smtpSettingsHelp}" />
			</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader
						addStyleNames="{style.panel-header-bg-color}" ui:field="panelHeader" showBackButton="false" headerText="{i18n.smtpSettings}" />
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL">
								<b:FormGroup ui:field='formGroupSmtpServer'>
									<m:ObidosRowBottom2px>
										<b:FormLabel for="forSmtpServer" ui:field='smtpServerFormLabel' addStyleNames="col-sm-4" HTML="{i18n.smtpServer}" />
										<g:FlowPanel addStyleNames="col-sm-4">
									   	   <m:ObidosTextBox ui:field="smtpServerTextBox" placeholder="{i18n.smtpServerPlaceHolder}" allowBlank="false" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='secureConnectionLabel' addStyleNames="col-sm-4" HTML="{i18n.smtpConnection}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<!-- setting value here does not seem to work -->
											<b:ListBox b:id="connectionType" ui:field='connectionTypeListBox'>
												<g:item text="{i18n.startTLS}" />
												<g:item text="{i18n.ssl}" />
												<g:item text="{i18n.notSecure}" />
											</b:ListBox>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel ui:field='smtpPortLabel' for="forSmtpPort" addStyleNames="col-sm-4" HTML="{i18n.smtpPort}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosIntegerTextBox ui:field="smtpPortTextBox" placeholder="{i18n.smtpPortPlaceHolder}" allowBlank="false" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px ui:field='authUserRow'>
										<b:FormLabel ui:field="smtpAuthUserLabel" addStyleNames="col-sm-4" HTML="{i18n.smtpAuthUser}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field="smtpAuthUserTextBox" placeholder="{i18n.smtpAuthUser}" allowBlank="false" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRow bottomMargin="4px" ui:field='authPassRow'>
										<b:FormLabel ui:field="smtpAuthUsrPassLabel" addStyleNames="col-sm-4" HTML="{i18n.smtpAuthPassword}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup ui:field='inputGroup'>
												<m:ObidosPasswordBox ui:field="smtpAuthUserPasswordBox" placeholder="{i18n.smtpAuthPassword}" />
												<b:InputGroupButton>
													<b:Button type="INFO" icon="EYE" ui:field='showHidePasswordButton' text="" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRow>

    								<m:ObidosMessageRow ui:field="messageRow" />

									<m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
										<b:Button type="SUCCESS" ui:field='saveButton' text="{i18n.update}" />
										<m:ObidosResetButton ui:field='resetButton' />
										<b:Button type="DANGER" ui:field='deleteButton' text="{i18n.delete}" enabled="false"/>
									</m:ObidosButtonToolBar>
								</b:FormGroup>

								<!-- send test mail -->
								<b:Row>
									<b:Row>
										<g:FlowPanel addStyleNames="{style.center-label}">
											<b:FormLabel text="{i18n.sendTestMail}" />
										</g:FlowPanel>
									</b:Row>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="testFromAddress" addStyleNames="col-sm-4" text="{i18n.fromAddress}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field='testFromTextBox' placeholder="{i18n.fromAddressPlaceHolder}" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="testToAddress" addStyleNames="col-sm-4" text="{i18n.toAddress}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field='testToTextBox' placeholder="{i18n.toAddressPlaceHolder}" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom2px>
										<b:FormLabel for="subject" addStyleNames="col-sm-4" text="{i18n.subject}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field='subjectTextBox' placeholder="{i18n.subject}" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRowBottom3px>
										<b:FormLabel for="message" addStyleNames="col-sm-4" text="{i18n.message}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<m:ObidosTextBox ui:field='messgaeTextBox' placeholder="{i18n.message}" />
										</g:FlowPanel>
									</m:ObidosRowBottom3px>

    								<m:ObidosMessageRow ui:field="messageRowSendEmail" />

									<m:ObidosButtonToolBar ui:field="testEmailBar">
										<b:Button type="PRIMARY" ui:field='testEmailButton' text="{i18n.sendTestMail}" />
									</m:ObidosButtonToolBar>
								</b:Row>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
<ui:style gss="true">
.form-error-label {
	color: red;
}

.cont-help-bq {
	background-color: #EEEEEE;
	border-color: #2F79B9;
}

.margin-fix {
	margin-top: 0 !important;
}

.message-data-grid-cell td div {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.cont-help-paragraph-font {
	font-size: 13px;
}

.bottom-margin {
	margin-bottom: 2px;
}

.left-margin {
	padding: 0px;
	margin-left: 15px;
}

.center-toolbar {
	justify-content: center;
	display: flex;
}

.button-width {
	width: 120px;
}

.toolbar-margin {
	margin-left: -10px !important;
}
.center-toolbar {
	justify-content: center;
	display: flex;
}
.checkbox-label {
	font-weight: bold !important;
	color: #337ab7 !important;
}
.select-button {
	font-weight: bold !important;
	padding: 2px 4px;
}
</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.cont-help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.cont-help-paragraph-font}' HTML="{i18n.notificationMessagesHelp}" />
			</b:BlockQuote>
			<b:Panel type="PRIMARY">
   	            <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.notificationMessages}"/>
				<b:PanelBody>
					<g:HTMLPanel>
						<b:Form type="HORIZONTAL">
    						<m:ObidosRow bottomMargin="4px">
                                <g:FlowPanel addStyleNames="text-center">
									<m:ObidosButtonToolBar ui:field="buttonToolBar">
										<b:Button ui:field='unreadMessageButton' type="SUCCESS" block="false" badgePosition="LEFT" badgeText="0" text="{i18n.unreadMessages}"/>
										<b:Button ui:field='readMessageButton' block="false" badgePosition="LEFT" badgeText="0" text="{i18n.readMessages}"/>
									</m:ObidosButtonToolBar>
                                </g:FlowPanel>
                            </m:ObidosRow>
							<m:ObidosRowBottom2px>
								<g:FlowPanel addStyleNames="text-center">
								    <b:InlineCheckBox ui:field="markReadAfterViewCheckBox" value="false" text="{i18n.markAsReadAfterView}"/>
								</g:FlowPanel>
							</m:ObidosRowBottom2px>


							<m:ObidosMessageRow ui:field="messageRow"/>

							<b:Row ui:field="selectCheckBoxRow">
								<g:FlowPanel addStyleNames="{style.left-margin}">
									<b:Button ui:field="selectButton" type="LINK" icon="CHECK_SQUARE_O" addStyleNames="{style.select-button}" text="{i18n.select}"/>
									<b:Button ui:field="markReadButton" type="LINK" icon="CHECK" addStyleNames="{style.select-button}" text="{i18n.markRead}"/>
									<m:ObidosDeleteButton ui:field="deleteButton"/>
								</g:FlowPanel>
							</b:Row>
						</b:Form>

						<b.gwt:DataGrid addStyleNames='{style.message-data-grid-cell}' bordered="true" condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
						<g:HTMLPanel ui:field="htmlPanel">
							<table style="width:100%">
								<tr>
									<td align='center'>
										<c:SimplePager ui:field='pager' />
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</b:PanelBody>
			</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">
	<ui:with field='i18n'
		type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-error-label {
		color: red;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.paragraph-font {
		font-size: 13px;
	}
	
	.info {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.readonly-font {
		color: black;
		font-weight: bold;
	}
	</ui:style>
	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
				<b:BlockQuote addStyleNames="{style.info}" ui:field="helpBlockQuote" visible="false">
					<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.paragraph-font}' HTML="{i18n.sessionHelpHtml}" />
				</b:BlockQuote>
					<b:Panel type="PRIMARY">
				        <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.sessionInfo}"/>
						<b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">
									<m:ObidosMessageRow ui:field="messageRow"/>

									<b:FormGroup ui:field='createUserFormGroup'>
										<b:Row visible="false">
											<b:FormLabel for="forLoginName" addStyleNames="col-sm-4">Session ID</b:FormLabel>
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="sessionIdTextBox" readOnly="true" />
											</g:FlowPanel>
										</b:Row>

										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel for="forFullname" addStyleNames="col-sm-4" text="{i18n.sessionCreatedAt}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="createdTextBox" addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel for="forFullname" addStyleNames="col-sm-4" text="{i18n.sessionLastAccessed}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="lastAccessTextBox" addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel for="forFullname"
												addStyleNames="col-sm-4" text="{i18n.sessionExpiresAt}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="expiresTextBox" addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel for="forFullname"
												addStyleNames="col-sm-4"
												text="{i18n.sessionDialogPopsAround}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="dialogPopsTextBox" addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel for="forFullname"
												addStyleNames="col-sm-4" text="{i18n.sessionTimeout}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="maxInactiveTextBox" addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel for="forFullname"
												addStyleNames="col-sm-4" text="{i18n.sessionTimerRunning}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="sessionCheckTimerTextBox" addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel for="forFullname"
												addStyleNames="col-sm-4"
												text="{i18n.sessionGraceTimerRunning}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="graceTimerTextBox"
													addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>

										<m:ObidosRow bottomMargin="15px">
											<b:FormLabel for="now" addStyleNames="col-sm-4"
												text="{i18n.sessionUpdatedAt}" />
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosTextBox ui:field="nowTextBox" addStyleNames="{style.readonly-font}" readOnly="true" />
											</g:FlowPanel>
										</m:ObidosRow>


                                        <!--  Remove Extend Session button, there is no need for it. it was done for development testing long time ago -->
									</b:FormGroup>
								</b:Form>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

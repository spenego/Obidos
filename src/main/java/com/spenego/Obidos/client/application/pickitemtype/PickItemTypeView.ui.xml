<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.item-message-info {
		margin: 10px 0px;
		padding: 12px;
		color: #00529B;
		background-color: #BDE5F8;
		box-shadow: 1px 1px 3px #888;
	}
	
	.form-error-label {
		color: red;
	}
	
	.item-ginfo {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.item-paragraph-font {
		font-size: 13px;
	}
	
	.item-margin {
		margin: 5px;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	
	.spacer {
		margin: 0;
		padding: 0;
		height: 0.1em;
	}
	
	.doublespacer {
		margin: 0;
		padding: 0;
		height: 1em;
	}
	
	.bottom-margin {
		margin-bottom: 50px;
	}
	</ui:style>

	<!-- ********************************************************************* This is the UI 
		for ********************************************************************* -->

	<g:HTMLPanel ui:field="htmlPanel">
		<b:Container addStyleNames="col-sm-12">
			<b:BlockQuote addStyleNames="{style.item-ginfo}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='newGroupInfoParagraph' addStyleNames='{style.item-paragraph-font}' HTML="{i18n.pickItemTypeHelp}" />
			</b:BlockQuote>
			<b:Row>
			<b:Panel type="PRIMARY">
				<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.pickAnItemType}" />
				<b:PanelBody>
					<g:HTMLPanel>
						<b:Form type="HORIZONTAL">
							<m:ObidosRowBottom2px> <b:FormLabel addStyleNames="col-sm-offset-5" text="{i18n.selectItemType}" />

								<g:FlowPanel addStyleNames="col-sm-offset-5 col-sm-7">
									<b:InlineRadio name="radio1" formValue="asNote"
										ui:field='asNoteRadio' text="{i18n.asNote}" value="false" />
								</g:FlowPanel>

								<g:FlowPanel addStyleNames="col-sm-offset-5 col-sm-7">
									<b:InlineRadio name="radio1" formValue="useGlobalTemplate"
										ui:field='useGlobalTemplateRadio' text="{i18n.useGlobalTemplate}" value="false" />
								</g:FlowPanel>

								<g:FlowPanel addStyleNames="col-sm-offset-5 col-sm-7">
									<b:InlineRadio name="radio1" formValue="usePersonalTemplate"
										ui:field='usePersonalTemplateRado' text="{i18n.usePersonalTemplate}"
										value="false" />
								</g:FlowPanel>

								<g:FlowPanel addStyleNames="col-sm-offset-5 col-sm-7">
									<b:InlineRadio name="radio1" formValue="freeFormat"
										ui:field='freeFormatRadio' text="{i18n.freeFormat}" value="false" />
								</g:FlowPanel>
							</m:ObidosRowBottom2px>

							<m:ObidosMessageRowWithStyle
								style="col-sm-offset-5 col-sm-8" ui:field="messageRow" />

							<b:Row>
								<g:FlowPanel>
									<m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
										<b:Button type="SUCCESS" b:id='pick' ui:field='pickButton' icon="ARROW_RIGHT"
											iconPosition="RIGHT" text="{i18n.next}" />
										<b:Button type="PRIMARY" ui:field='listButton'
											text="{i18n.listContainers}" visible="false" />
									</m:ObidosButtonToolBar>
								</g:FlowPanel>
							</b:Row>
						</b:Form>
					</g:HTMLPanel>
				</b:PanelBody>
			</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

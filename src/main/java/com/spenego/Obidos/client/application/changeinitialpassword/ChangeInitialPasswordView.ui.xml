<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.form-title {
		color: #666;
		font-size: 18px;
		font-weight: 400;
		display: block;
	}
	
	.form-title-small {
		color: #9900ff;
		font-size: 16px;
		font-weight: 400;
		display: block;
	}
	
	.passwordStrengthLabel {
		font-size: 10px;
		line-height: normal;
	}
	
	.passwordStrengthBar {
		height: 15px;
		line-height: 15px;
		font-size: 10px;
	}
	
	.info {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}
	
	.margin-fix-x {
		margin-top: 0 !important;
	}
	
	.paragraph-font-x {
		font-size: 13px;
	}
	
	.x-suggestion-list-color {
		color: #009999;
	}
	
	.bottom-margin {
		margin-bottom: 5px;
	}
	
	.progress-height {
		font-size: 0.9em;
		line-height: 1 !important;
	}
	
	.progress-margin {
		margin-bottom: 0px !important;
	}
	
	.progress-left-padding {
		padding-left: 0px !important;
	}
	
	.right-padding {
		padding-right: 0px;
	}
    /* https://www.w3schools.com/howto/tryit.asp?filename=tryhow_css_loader */
    /* I seem to like this one better */
    .loading {
        display: inline-flex;
        align-items: center;
        margin-left: 0px; 
        position: relative; 
        top: 10px !important; 
        /* position: absolute; */
        /*margin-left: 4px;*/
        /*top: 50%;*/
        /* left: 65%; */
    }
    .loader {
      border: 2px solid #f3f3f3;
      border-radius: 50%;
      /* border-top: 2px solid #3498db; */
      border-top: 2px solid #9900ff;
      width: 16px;
      height: 16px;
      -webkit-animation: spin 2s linear infinite; /* Safari */
      animation: spin 2s linear infinite;
    }

    /* Safari */
    @-webkit-keyframes spin {
      0% { -webkit-transform: rotate(0deg); }
      100% { -webkit-transform: rotate(360deg); }
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:Row>
			<b:BlockQuote addStyleNames="{style.info}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='passwordResetParagraph' addStyleNames='{style.paragraph-font-x}' HTML="{i18n.changeInitialPasswordHelp}" />
			</b:BlockQuote>
				<b:Panel type="PRIMARY">
					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.changeInitialPassword}"/>
					<b:PanelBody>
						<g:HTMLPanel>
							<b:Form type="HORIZONTAL" ui:field='suggestionForm'>
							<m:ObidosRowBottom20px>
								<b:Row>
									<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
										<b.html:Strong text="{i18n.resetPasswordsuggestionForStringPassword}" />
										<b:ListGroup addStyleNames='{style.x-suggestion-list-color}'>
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp1}" type="DEFAULT"/>
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp2}" type="DEFAULT"/>
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp3}" type="DEFAULT"/>
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp4}" type="DEFAULT"/>
											<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp5}" type="DEFAULT"/>
										</b:ListGroup>
									</g:FlowPanel>
								</b:Row>
							</m:ObidosRowBottom20px>

								<m:ObidosRowBottom2px>
									<b:FormLabel for="forCurrentassword" addStyleNames="col-sm-4" text="{i18n.currentPassword}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<b:InputGroup>
											<m:ObidosPasswordBox ui:field="oldPasswordBox" b:id="oldPass" placeholder="{i18n.currentPassword}" allowBlank="false" />
											<b:InputGroupButton>
												<b:Button type="INFO" icon="EYE" ui:field='showHideCurrentPasswordButton' text="" />
											</b:InputGroupButton>
										</b:InputGroup>
									</g:FlowPanel>
									<g:HTMLPanel ui:field="processingPanel" addStyleNames="{style.loading}" visible="false">
									  <span class="{style.loader}"></span>
									</g:HTMLPanel>

								</m:ObidosRowBottom2px>
								<m:ObidosRowBottom2px>
									<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-4">
										<b:Label ui:field="ncharsLabel" text="0" type="DEFAULT" />
									</g:FlowPanel>
								</m:ObidosRowBottom2px>
								<m:ObidosRowBottom2px>
									<b:FormLabel for="forNewPassword" addStyleNames="col-sm-4" text="{i18n.newPassword}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<b:InputGroup>
											<m:ObidosPasswordBox ui:field="newPasswordBox" b:id="newPass" placeholder="{i18n.newPassword}" allowBlank="false" />
											<b:InputGroupButton>
												<b:Button type="INFO" icon="EYE" ui:field='showHideNewPasswordButton' text="" />
											</b:InputGroupButton>
										</b:InputGroup>
									</g:FlowPanel>
									<g:FlowPanel addStyleNames="col-sm-4 {style.progress-left-padding}">
										<g:Label ui:field='passwordStrengthLabel' addStyleNames="pl-0 ml-0 {style.progress-height}" text="{i18n.passwordStrength}" />
										<b:Progress ui:field='passwordStrengthProgress' addStyleNames="pl-0 ml-0 {style.progress-margin}">
											<b:ProgressBar ui:field='passwordStrengthBar' type="DANGER" percent="25" text="weak" />
										</b:Progress>
									</g:FlowPanel>
								</m:ObidosRowBottom2px>

								<m:ObidosRowBottom2px>
									<b:FormLabel for="forConfirmPassword" addStyleNames="col-sm-4" text="{i18n.resetPasswordConfirmPassword}" />
									<g:FlowPanel addStyleNames="col-sm-4">
										<b:InputGroup>
											<m:ObidosPasswordBox ui:field="confirmNewPasswordBox" b:id="repNewPass" placeholder="{i18n.confirmNewPassword}" allowBlank="false" />
											<b:InputGroupButton>
												<b:Button type="INFO" icon="EYE" ui:field='showHideConfirmPasswordButton' text="" />
											</b:InputGroupButton>
										</b:InputGroup>
									</g:FlowPanel>
								</m:ObidosRowBottom2px>

								<m:ObidosMessageRow ui:field="messageRow" />

								<m:ObidosRowBottom40px>
								<b:Row>
									<m:ObidosButtonToolBar ui:field="buttonToolBar">
										<b:Button type="SUCCESS" b:id="change" ui:field='changePasswordButton' text="{i18n.changePassword}" />
										<b:Button type="PRIMARY" ui:field='logoutButton' text="{i18n.logout}" />
									</m:ObidosButtonToolBar>
								</b:Row>
							</m:ObidosRowBottom40px>
								<b:Row>
									<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
										<b.html:Strong HTML="{i18n.passwordRequirementsLabel}" />
										<b:ListGroup ui:field='passwordRequirementListGroup'>
											<b:ListGroupItem HTML="{i18n.passwordRequirementHelp1}" type="DEFAULT" />
										</b:ListGroup>
									</g:FlowPanel>
								</b:Row>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>

</ui:UiBinder>

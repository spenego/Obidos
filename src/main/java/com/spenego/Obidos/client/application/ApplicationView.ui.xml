<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
        	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>

<ui:style gss="true">
.buttons button {
	margin: 0.5em;
}
.labels span {
	margin-right: 5px;
}
.passphrase-icon{
	font-size:18px;
	vertical-align: middle;
	margin-top: 14px !important;
}
.red-text-color {
	background:red;
	color:#00ffff !important;
}
.navbar-default {
    background-color: #298278;
    border-color: #a28885;
}
.center-pills {
	margin-top:7.5%;
}
.badgex {
  padding: 1px 9px 2px;
  font-size: 12.025px;
  font-weight: normal;
  white-space: nowrap;
  color: #ffffff;
  background-color: #999999;
  -webkit-border-radius: 9px;
  -moz-border-radius: 9px;
  border-radius: 3px;

}
.badge {
	margin-top:2px;
  font-size: 10px;
  font-weight: normal;
  white-space: nowrap;
  background-color: #00f;
  color: #fff;
  border-radius: 1px;
  radius: 2px;
}
.badge3 {
  background-color: #f00;
  color: #fff;
}
.center-button {
	margin-top:6px;
}
    /* https://www.w3schools.com/howto/tryit.asp?filename=tryhow_css_loader */
    /* I seem to like this one better */
    .loading {
        display: inline-flex;
        align-items: center;
        margin-left: 10px; 
        /* position: relative; */
        /* top: 5px !important; */
        position:absolute; 
        top:20px; 
        left:10px;
    }
    .loader {
      border: 2px solid #f3f3f3;
      border-radius: 50%;
      /* border-top: 2px solid #3498db; */
      border-top: 2px solid #9900ff;
      width: 16px;
      height: 16px;
      -webkit-animation: spin 2s linear infinite; /* Safari */
      animation: spin 2s linear infinite;
    }

    /* Safari */
    @-webkit-keyframes spin {
      0% { -webkit-transform: rotate(0deg); }
      100% { -webkit-transform: rotate(360deg); }
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
</ui:style>

<!-- 
Note: we use scrollbars, therefore you will notice navbar will shift when
the content has scrollbars, that's how bootstrap works at this time.
 -->

<g:ScrollPanel ui:field='scrollPanel'>
	<b:Container>
		<b:Navbar ui:field='navBar' position="FIXED_TOP">
			<b:Container>
				<b:NavbarHeader>
					<b:NavbarBrand ui:field="navBarBrand" text="{i18n.obidos}" b:id="obidos" />

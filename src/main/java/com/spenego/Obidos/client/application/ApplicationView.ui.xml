					<!-- user menu items ends -->
				
					
				</b:NavbarNav>	
				<!--  part of admin menu -->
				<b:NavbarForm pull="LEFT" visible="false">
			      <m:ObidosTextBox ui:field="searchBox" placeholder="{i18n.searchUsers}" addStyleNames="col-sm-8"/>
			      <b:Button ui:field="searchButton" type="DEFAULT" icon="SEARCH"/>
			    </b:NavbarForm>
			    
               
                <!--  Reports -->
                <b:NavbarNav>
					<b:ListDropDown ui:field="auditDropDown">
                        <b:AnchorButton ui:field="auditAnchorButton" dataToggle="DROPDOWN" text="{i18n.audit}"/>

							<b:AnchorListItem ui:field="createNewAdmin" b:id="cna" text="{i18n.createNewAdmin}"/>
							<b:AnchorListItem ui:field="listadmins" b:id="la" text="{i18n.activeAdmins}"/>
							<b:AnchorListItem ui:field="listLockedAdminAnchorList" b:id="ll" text="{i18n.listLockedAdmins}"/>
    						<b:AnchorListItem ui:field="listDeletedAdmins" b:id="ldu" text="{i18n.listDeletedAdmins}"/>

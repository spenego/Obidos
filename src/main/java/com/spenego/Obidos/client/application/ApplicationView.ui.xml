							<b:Divider/>
							-->
							<b:AnchorListItem ui:field="listSmtpSettingsAnchorListItem" text="{i18n.listSMTPSettings}" b:id="lss" visible="false"/>
							<!-- 
							<b:Divider/>
							-->
							<b:Divider/>
							<b:AnchorListItem ui:field="installCertificate" b:id="ioc" text="{i18n.installObidosCertificate}"/>
							<b:AnchorListItem ui:field="installAdCertificate" b:id="iadc" text="{i18n.installAdLdapCertificate}"/>
							<b:AnchorListItem ui:field="viewCertificate" b:id="ilic" text="{i18n.viewCertificates}"/>
							<b:Divider/>
							<b:AnchorListItem ui:field="displayLicenseAdmin" b:id="dlia" text="{i18n.displayLicense}"/>
							<b:AnchorListItem ui:field="installLicense" b:id="ilic" text="{i18n.installLicense}"/>
							<b:Divider/>
							<b:AnchorListItem ui:field="navSettignsHelp" text="{i18n.helpButtonTitle}"/>
						</b:DropDownMenu>
					</b:ListDropDown>

					<!-- admin menus ends -->

					<!-- user menu items starts -->
					<b:ListDropDown>
						<b:AnchorButton dataToggle="DROPDOWN" ui:field="notesAnchorButton" text="{i18n.notes}" b:id="notesmenu"/>
						<b:DropDownMenu>
							<b:AnchorListItem ui:field="createNoteAnchorList" text="{i18n.createNewNote}" b:id="newnote"/>
							<b:Divider/>
							<b:AnchorListItem ui:field="listNotesAnchorList" text="{i18n.listMyNotes}" b:id="mynotes"/>
							<b:AnchorListItem ui:field="listNotesSharedWithOthersAnchorList" text="{i18n.listMyNotesSharedWithOthers}"/>
							<b:AnchorListItem ui:field="listNotesSharedWithMeAnchorList" text="{i18n.listNotesSharedWithMe}"/>
							<b:Divider/>
							<b:AnchorListItem ui:field="notesHelpAnchorList" text="{i18n.helpButtonTitle}"/>
						</b:DropDownMenu>
    				</b:ListDropDown>
    				

<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:c="urn:import:com.google.gwt.user.cellview.client"
             xmlns:summer="urn:import:com.spenego.Obidos.client.application.widgets.summernote"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<!--  https://isabelcastillo.com/error-info-messages-css -->
<ui:style gss="true">
.share-note-message-error{
    margin: 10px 0px;
    padding:12px;
    color: #D8000C;
    background-color: #FFBABA;
    box-shadow:1px 1px 3px #888;
}
.share-note-message-info{
    margin: 10px 0px;
    padding:12px;
    color: #00529B;
    background-color: #BDE5F8;
    box-shadow:1px 1px 3px #888;
}
.form-error-label{
    color: red;
}
.margin-fix {
    margin-top: 0 !important;
}
.margin {
    margin: 5px;
}
.noteUsersDataGridCell td div{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.help-bq {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.help-paragraph-font {
    font-size: 13px;    
}
</ui:style>

<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
	   <b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
			<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="{i18n.listContainersHelp}"/>
		</b:BlockQuote>
		<b:Row>
				<b:Panel type="PRIMARY">
					<b:PanelHeader>
						<b:Heading size="H3" ui:field='panelHeading' text="Note Shared With the Users"/>
					</b:PanelHeader>
					<b:PanelBody>
						<b:Form type="HORIZONTAL">
						<b:FormGroup>
						  <b:Row>
							<b:FormLabel for="forNoteName" ui:field='noteNameLabel' addStyleNames="col-sm-2">Note Name</b:FormLabel>
							<g:FlowPanel addStyleNames="col-sm-10">
								<m:ObidosTextBox ui:field="noteNameTextBox" enabled="false"/>
							</g:FlowPanel>
  						  </b:Row>

                          <b:Row>
							<b:FormLabel for="forCommentsLabel" ui:field='commentsLabel' addStyleNames="col-sm-2">Note</b:FormLabel>
							<g:FlowPanel addStyleNames="col-sm-10">
								<summer:Summernote ui:field='summerNote' enabled="false"/>
							</g:FlowPanel>
						</b:Row>
							
							<m:ObidosMessageRow ui:field="messageRow"/>

                         <b:Row>
							<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-10">
								<b:Button type="PRIMARY" ui:field='listNotesButton' block="true" text="List My Notes"/>
								<b:Button type="DANGER" ui:field='unshareNoteButton' block="true" text="Unshare This Note"/>
								<b:Button type="INFO" ui:field='helpButton' block="true" text="{i18n.helpButtonTitle}"/>
							</g:FlowPanel>
						</b:Row>
						   </b:FormGroup>
						</b:Form>

						<g:HTMLPanel>
							<b.gwt:DataGrid bordered="true" addStyleNames='{style.noteUsersDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid"/>
							<g:HTMLPanel ui:field="htmlPanel2">
								<table style="width:100%">
								  <tr>
									<td align='center'>
									  <c:SimplePager ui:field='pager' />
									</td>
								  </tr>
								</table>
							</g:HTMLPanel>
						</g:HTMLPanel>
				    </b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:d="urn:import:com.spenego.Obidos.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>

<ui:style gss="true">
.resetp-req-form-title{
    color: #666;
    font-size: 18px;
    font-weight: 400;
    display: block;
}
.form-error-label{
    color: red;
} 
.resetreq-danger{
	background-color: #fcf2f2;
	border-color: #dFb5b4;
}
.margin {
	margin: 5px;
}
.help-bq {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.help-paragraph-font {
    font-size: 13px;    
}
</ui:style>
    
<g:HTMLPanel ui:field="htmlPanel">
    <b:Container addStyleNames="col-sm-12">
        <b:Row>
			   <b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
					<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="{i18n.resetPassphraseHelp}"/>
				</b:BlockQuote>
                    <b:Panel ui:field='resetReqPanel' type="PRIMARY">
      					<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.resetPassphrase}"/>
                        <b:PanelBody>
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL">
									<b:FormGroup ui:field='resetReqEmailFormGroup'>
									<m:ObidosMessageRow ui:field="messageRow"/>
									   <m:ObidosRow bottomMargin="2x">
											<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-4">
												<b:Button type="SUCCESS" ui:field='sendEmailButton' block="false" text="{i18n.sendMeResetPassphraseInstructions}"/>
											</g:FlowPanel>
										</m:ObidosRow>
									</b:FormGroup>
								</b:Form>
							</g:HTMLPanel>
                        </b:PanelBody>
                    </b:Panel>
        </b:Row>
    </b:Container>
</g:HTMLPanel>
</ui:UiBinder>

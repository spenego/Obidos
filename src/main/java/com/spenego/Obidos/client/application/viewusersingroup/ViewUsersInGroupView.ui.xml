<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />

<ui:style gss="true">
.xmessage-info {
	margin: 10px 0px;
	padding: 12px;
	color: #00529B;
	background-color: #BDE5F8;
	box-shadow: 1px 1px 3px #888;
}

.xmessage-error {
	margin: 10px 0px;
	padding: 12px;
	color: #D8000C;
	background-color: #FFBABA;
	box-shadow: 1px 1px 3px #888;
}

.form-error-label {
	color: red;
}

.listUsersToGroupDataGridCell td div {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.help-bq {
	background-color: #EEEEEE;
	border-color: #2F79B9;
}

.help-paragraph-font {
	font-size: 13px;
}

.margin-fix {
	margin-top: 0 !important;
}
.bottom-margin {
	margin-bottom: 3px;
}
.center-toolbar {
	justify-content: center;
	display: flex;
}
</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
			<b:BlockQuote addStyleNames="{style.help-bq}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.help-paragraph-font}' HTML="TODO" />
			</b:BlockQuote>

			<b:Row>
					<b:Panel type="PRIMARY">
			            <m:ObidosPanelHeader ui:field="panelHeader" showBackButton="true" headerText="{i18n.listUsersInGroup}"/>
						<b:PanelBody>
							<b:Form type="HORIZONTAL">
									
									<m:ObidosRowBottom2px>
										<b:FormLabel for="forGroupName" ui:field='groupNameLabel' addStyleNames="col-sm-4" text="{i18n.groupname}" />
										<g:FlowPanel addStyleNames="col-sm-4">
 										    <m:ObidosInputGroup ui:field="groupNameInputGroup" readOnly="true" isSecure="false" placeHolder="{i18n.groupname}"/>
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

									<m:ObidosRow bottomMargin="2px">
										<b:FormLabel for="forCommentsLabel" ui:field='commentsLabel' addStyleNames="col-sm-4" text="{i18n.commentLabel}" />
										<g:FlowPanel addStyleNames="col-sm-6">
											<b:TextArea ui:field="commentsTextArea" enabled="false" />
										</g:FlowPanel>
									</m:ObidosRow>
									
									<m:ObidosRow bottomMargin="2px">
										<b:FormLabel for="forSearchName" addStyleNames="col-sm-4" text="{i18n.searchUsers}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosTextBox ui:field='searchTextBox' placeholder="{i18n.searchUsers}" />
												<b:InputGroupButton>
													<b:Button ui:field="searchButton" type="PRIMARY" icon="SEARCH" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</m:ObidosRow>
									<m:ObidosMessageRow ui:field="messageRow"/>
							</b:Form>

							<g:HTMLPanel>
								<b.gwt:DataGrid bordered="true" addStyleNames='{style.listUsersToGroupDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
								<g:HTMLPanel ui:field="htmlPanel">
									<table style="width:100%">
										<tr>
											<td align='center'>
												<c:SimplePager ui:field='pager' />
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
			</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

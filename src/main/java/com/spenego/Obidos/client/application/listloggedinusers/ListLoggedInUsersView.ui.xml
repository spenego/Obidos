<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
    xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
    xmlns:c="urn:import:com.google.gwt.user.cellview.client"
    xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
<ui:style gss="true">
    .myDataGridCell td div {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    
    .redBackground {
        background-color: #ff0000;
    }
    
    .message-info {
        margin: 10px 0px;
        padding: 12px;
        color: #00529B;
        background-color: #BDE5F8;
        box-shadow: 1px 1px 3px #888;
    }
    
    .list-users-panel-header {
        background-color: #222 !important;
    }
    
    .h-paragraph-font {
        font-size: 13px;
    }
    
    .item-ginfo {
        background-color: #EEEEEE;
        border-color: #2F79B9;
    }
    
    .margin-fix {
        margin-top: 0 !important;
    }
    .form-error-label{
        color: red;
    }
    .left-margin-x {
        padding: 15px;
        margin-left: 5px;
    }
    .left-margin {
        padding: 0px;
        margin-left: 5px;
    }

    .center-toolbar {
        justify-content: center;
        display: flex;
    }
    .sort-style {
        font-weight: bold;
    }
	.vprogressbar {
		height: 7px !important;
	}

</ui:style>
    <g:HTMLPanel>
        <b:Container addStyleNames="col-sm-12">
            <b:Row>
                <b:BlockQuote addStyleNames="{style.item-ginfo}" ui:field='helpBlockQuote' visible="false">
                    <b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.h-paragraph-font}' HTML="{i18n.listLoggedInUsersHelp}"/>
                </b:BlockQuote>
                    <b:Panel type="PRIMARY">
                        <m:ObidosPanelHeader addStyleNames="{style.list-users-panel-header}" ui:field="panelHeader" showBackButton="false" headerText="{i18n.listLoggedInUsers}"/>
                        <b:PanelBody>
                            <g:HTMLPanel>
                                <b:Form type="HORIZONTAL">
									<!--  API does not support search at this time, so keep it hidden -->
									<b:Row visible="false">
										<b:FormLabel addStyleNames="col-sm-4" ui:field='searchLabel' text="{i18n.searchUsers}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosTextBox ui:field='searchTextBox' placeholder="{i18n.searchUsers}"/>
												<b:InputGroupButton>
													<b:Button ui:field="searchButton" type="PRIMARY" icon="SEARCH" />
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
									</b:Row>

									<b:Row ui:field="contentRow" visible="true">
										<b:Row ui:field="refreshTimerCheckBoxRow">
											<b:FormLabel ui:field='refreshTimerLabel' addStyleNames="col-sm-4" text="{i18n.refreshTimer}" />
											<g:FlowPanel addStyleNames="col-sm-8">
												<b:CheckBox ui:field="refreshCheckBox" text="" />
											</g:FlowPanel>
											<g:FlowPanel addStyleNames="col-sm-offset-4 col-sm-4">
												<b:Progress ui:field='progress' addStyleNames='{style.vprogressbar}'>
													<b:ProgressBar ui:field='progressbar' type="INFO" percent="100" />
												</b:Progress>
											</g:FlowPanel>
										</b:Row>
									</b:Row>

        						    <m:ObidosRowBottom2px>
								        <m:ObidosButtonToolBar ui:field="bottomToolBar">
											 <b:Button type="SUCCESS" ui:field='refreshButton' width="130px" text="{i18n.refresh}"/>
										 </m:ObidosButtonToolBar>
									 </m:ObidosRowBottom2px>

									<m:ObidosMessageRow ui:field="messageRow"/>

									<!--  API does not support sorting at this time, so keep it hidden -->
                                    <b:Row ui:field="sortRow" visible="false">
                                        <g:FlowPanel addStyleNames="{style.left-margin}">
                                            <b:ButtonGroup>
                                                <b:Button type="LINK" icon="SORT" addStyleNames="{style.sort-style}" dataToggle="DROPDOWN" toggleCaret="false" text="{i18n.sort}" />
                                                <b:DropDownMenu>
                                                    <b:AnchorListItem ui:field="sortByDate" text="{i18n.sortByUpdatedDate}" />
                                                    <b:AnchorListItem icon="SORT_ALPHA_ASC" ui:field="sortByAZ" text="{i18n.sortByAlphabetAZ}" />
                                                    <b:AnchorListItem icon="SORT_ALPHA_DESC" ui:field="sortByZA" text="{i18n.sortByAlphabetZA}" />
                                                </b:DropDownMenu>
                                            </b:ButtonGroup>
                                        </g:FlowPanel>
                                    </b:Row>

                                </b:Form>
                                <b.gwt:DataGrid bordered="true" addStyleNames='{style.myDataGridCell}' condensed="true" striped="true" hover="true" width="100%" ui:field="dataGrid" />
                                <table style="width:100%">
                                    <tr>
                                        <td align='center'>
                                            <c:SimplePager ui:field='pager' />
                                        </td>
                                    </tr>
                                </table>
                            </g:HTMLPanel>
                        </b:PanelBody>
                    </b:Panel>
            </b:Row>
        </b:Container>
    </g:HTMLPanel>
</ui:UiBinder>

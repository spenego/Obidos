<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
	xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
	xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
	xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
    xmlns:b3="urn:import:org.gwtbootstrap3.extras.toggleswitch.client.ui"
    xmlns:select="urn:import:org.gwtbootstrap3.extras.select.client.ui"
	xmlns:d="urn:import:com.spenego.Obidos.client.ui">

	<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages' />
	<ui:style gss="true">
	.passwordStrengthLabel {
		font-size: 10px;
		line-height: normal;
	}
	
	.passwordStrengthBar {
		height: 15px;
		line-height: 15px;
		font-size: 10px;
	}
	
	.suggestionListColor {
		color: #009999;
	}

	.top-margin {
	   margin-top: 5px;
    }
	.cp-help-bq {
		background-color: #EEEEEE;
		border-color: #2F79B9;
	}

	.bottom-margin {
	   margin-bottom: 20px;
	}
	
	.margin-fix {
		margin-top: 0 !important;
	}
	
	.cp-help-paragraph-font {
		font-size: 13px;
	}
	
	.cp-panel-header {
		background-color: #222222 !important;
	}
	
	.center-toolbar {
		justify-content: center;
		display: flex;
	}
	
	.progress-margin {
	   margin-top: 7.5px !important;
	   margin-bottom: 0px !important;
	}
	.progressbar-margin {
	   margin-bottom: 4px !important;
	}
	
	.progress-height {
		font-size: 0.9em;
		line-height: 1 !important;
	}
	
	.progress-left-padding {
		padding-left: 0px !important;
	}
	.password-textbox {
	   /* font-family: Consolas, Lucida Console, monospace; */
	   font-weight: bold;
	}
    .customSelect button {
        color: #000 !important;
        font-weight: bold !important;
    }
	.info_label {
	   margin-left: -20px;
	   font-size: 12px;
	   weight: bold;
	   color: #9900ff !important;
	}
	.wait_label {
	   margin-left: 10px;
	   font-size: 12px;
	   weight: normal;
	   color: #00f !important;
	}

	.current_password_label {
	   margin-left: -20px;
	   margin-top: 5px;
	   font-weight: normal;
	   font-size: 12px;
	   font-family:  monospace, monospace;
	   color: #ccc !important;
	}

	.uhr {
		border-bottom: 1px solid #ccc;
		padding-bottom: 2px;
		margin-bottom: 4px;
		margin-top: 4px;
		margin-left: 2.9px;
	}
	.checkbox_style {
	   float: right;
	}
	
	/* by claude */
    .showBusy {
        display: inline-flex;
        align-items: center;
        margin-left: 4px;
        position: relative;
        top: -5px;
    }
    .loading {
        display: inline-flex;
        align-items: center;
        margin-left: 0px; 
        position: relative; 
        top: 0px; 
        /* position: absolute; */
        /*margin-left: 4px;*/
        /*top: 50%;*/
        /* left: 65%; */
    }
   
    .dots {
        display: inline-block;
        width: 20px;
        height: 20px;
        line-height: 20px;
        font-size: 24px;
        font-weight: bold;
    }
    
    .dots:after {
        content: '.';
        animation: rgbDots 1.5s steps(3) infinite;
    }
    
    @keyframes rgbDots {
        0% { content: '.'; color: #ff4444; }       /* red */
        33% { content: '..'; color: #4CAF50; }     /* green */
        66% { content: '...'; color: #2196F3; }    /* blue */
    }
    /* https://www.w3schools.com/howto/tryit.asp?filename=tryhow_css_loader */
    /* I seem to like this one better */
	.loader {
	  border: 2px solid #f3f3f3;
	  border-radius: 50%;
	  /* border-top: 2px solid #3498db; */
	  border-top: 2px solid #9900ff;
	  width: 16px;
	  height: 16px;
	  -webkit-animation: spin 2s linear infinite; /* Safari */
	  animation: spin 2s linear infinite;
	}

	/* Safari */
	@-webkit-keyframes spin {
	  0% { -webkit-transform: rotate(0deg); }
	  100% { -webkit-transform: rotate(360deg); }
	}

	@keyframes spin {
	  0% { transform: rotate(0deg); }
	  100% { transform: rotate(360deg); }
	}
	</ui:style>

	<g:HTMLPanel>
		<b:Container addStyleNames="col-sm-12">
				<b:Row>
				<b:BlockQuote addStyleNames="{style.cp-help-bq}" ui:field='helpBlockQuote' visible="false">
					<b.html:Paragraph ui:field='helpParagraph' addStyleNames='{style.cp-help-paragraph-font}' HTML="{i18n.generatePasswordHelp}" />
				</b:BlockQuote>
					<b:Panel type="PRIMARY">
						<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.generatePasswordPassphrase}" />
						<b:PanelBody ui:field="panelBody">
							<g:HTMLPanel>
								<b:Form type="HORIZONTAL" ui:field='suggestionForm'>
									<b:Row>
										<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8" visible="false">
											<b.html:Strong text="{i18n.resetPasswordsuggestionForStringPassword}" />
											<b:ListGroup addStyleNames='{style.suggestionListColor}'>
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp1}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp2}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp3}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp4}" type="DEFAULT" />
												<b:ListGroupItem HTML="{i18n.resetPasswordStrongPasswordHelp5}" type="DEFAULT" />
											</b:ListGroup>
										</g:FlowPanel>
									</b:Row>

									<m:ObidosRow bottomMargin="2px">
										<b:FormLabel for="forAlgorithm" addStyleNames="col-sm-4" text="{i18n.generationAlgorithm}" />
										<g:FlowPanel addStyleNames="col-sm-4">
                                               <select:Select addStyleNames="{style.customSelect}" liveSearch="false" ui:field="algorithmSelect" title="{18n.generationAlgorithm}" showTick="true">
                                                    <select:Option text="{i18n.defaultAlg}"/>
                                                    <select:Option text="{i18n.diceware}"/>
                                                    <select:Option text="{i18n.secureRandom}" value="{i18n.secureRandom}"/>
                                               </select:Select>
										</g:FlowPanel>
									</m:ObidosRow>

									<m:ObidosRow bottomMargin="2px" ui:field="rollDiceRow">
										<b:FormLabel for="forRollDice" addStyleNames="col-sm-4" text="Number of Dice Rolls" />
										<g:FlowPanel addStyleNames="col-sm-4">
                                               <select:Select addStyleNames="{style.customSelect}" liveSearch="false" ui:field="rollDieceSelect" title="{i18n.numberOfDiceRolls}" showTick="true">
                                                    <select:Option text="2"/>
                                                    <select:Option text="3"/>
                                                    <select:Option text="4"/>
                                                    <select:Option text="5"/>
                                                    <select:Option text="6"/>
                                                    <select:Option text="7"/>
                                                    <select:Option text="8"/>
                                               </select:Select>
										</g:FlowPanel>
									</m:ObidosRow>

									<m:ObidosRow bottomMargin="2px" ui:field='passLenRow'>
										<b:FormLabel addStyleNames="col-sm-4" text="{i18n.passwordLength}" />
										<g:FlowPanel addStyleNames="col-sm-4">
										  <m:ObidosIntegerTextBox ui:field='passwordLengthTextBox' text="16"/>
										</g:FlowPanel>
									</m:ObidosRow>

                                    <b:Row ui:field='modifierRow'>
										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel addStyleNames="col-sm-4" text="{i18n.capitalLetter}" />
											<g:FlowPanel addStyleNames="col-sm-4">
											<!-- 
											  <b:CheckBox ui:field="capitalizeCheckBox" text="At least one capital letter"/>
											  -->
											  <b:CheckBox ui:field="capitalizeCheckBox" text="{i18n.atleastOneCapitalLetter}"/>
											</g:FlowPanel>
										</m:ObidosRow>
										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel addStyleNames="col-sm-4" text="{i18n.number}" />
											<g:FlowPanel addStyleNames="col-sm-4">
											  <b:CheckBox ui:field="numberCheckBox" text="{i18n.atleastOneNumber}"/>
											</g:FlowPanel>
										</m:ObidosRow>
										<m:ObidosRow bottomMargin="2px">
											<b:FormLabel addStyleNames="col-sm-4" text="{i18n.specialCharacter}" />
											<g:FlowPanel addStyleNames="col-sm-4">
											  <b:CheckBox ui:field="symbolCheckBox" text="{i18n.atleastOnceSpecialCharacter}"/>
											</g:FlowPanel>
										</m:ObidosRow>
									</b:Row>

									<m:ObidosRow bottomMargin="5px">
									</m:ObidosRow>
									<b:Row>
									   <m:ObidosButtonToolBar>
											<b:Button type="SUCCESS" ui:field='generatePasswordRepeatButton' width="150px" text="{i18n.generate}"/>
											<b:FormLabel ui:field="waitLabel" addStyleNames='{style.wait_label}' HTML="Processing  "/>
                                             <g:HTMLPanel ui:field="dotsPanel" addStyleNames="{style.loading}" visible="false">
                                                <span class="{style.loader}"></span>
                                             </g:HTMLPanel>
									   </m:ObidosButtonToolBar>
									</b:Row>
									<m:ObidosRow bottomMargin="5px">
									</m:ObidosRow>

									<m:ObidosRowBottom2px>
   										<b:FormLabel for="forAlgeneratedPassword" addStyleNames="col-sm-4" text="{i18n.passwordPassphrase}" />
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:InputGroup>
												<m:ObidosTextBox ui:field="generatePasswordBox" addStyleNames="{style.password-textbox}" placeholder="{i18n.clickOnGenerateButton}" />
												<b:InputGroupButton>
													<b:Button type="DEFAULT" icon="CLIPBOARD" ui:field='copyToClipboardButton' text="" title="{18n.copy}"/>
												</b:InputGroupButton>
											</b:InputGroup>
										</g:FlowPanel>
										<g:FlowPanel addStyleNames="col-sm-4">
											<b:FormLabel ui:field='longPasswordHintLabel' addStyleNames='{style.info_label}' HTML="{i18n.longerPasswordHint}" />
										</g:FlowPanel>
									</m:ObidosRowBottom2px>

                                    <!--  only show when Generation is successful -->
                                    <b:Row ui:field='showEntropyRow' visible="false">
										<!--  horizontal separator -->
										<b:Row ui:field='bottomUhrRow'>
											<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
												<b:Row addStyleNames="{style.uhr}" />
											</g:FlowPanel>
										</b:Row>

										<!--  strength -->
										<m:ObidosRow bottomMargin="0px" ui:field="strengthRow" visible="true">
											<b:FormLabel for="forPStrength" addStyleNames="col-sm-4" text="{i18n.strength}" />
											<g:FlowPanel addStyleNames="col-sm-4 {style.progress-margin}">
												<b:Progress ui:field='passwordStrengthProgress' addStyleNames="{style.progressbar-margin}">
													<b:ProgressBar ui:field='passwordStrengthBar' type="DANGER" percent="20" text="weak"/>
												</b:Progress>
											</g:FlowPanel>
											<g:FlowPanel addStyleNames="col-sm-4">
												<b:FormLabel ui:field='passwordNearProgressBarLabel' addStyleNames='{style.current_password_label}' HTML="" />
											</g:FlowPanel>

										</m:ObidosRow>

										<!--  Raw Entropy -->
										<m:ObidosRowBottom2px ui:field="rawEntropyRow" visible="true">
											   <b:FormLabel for="forRawEntropyLabel" addStyleNames="col-sm-4" text="{i18n.rawEntropy}"/>
											<g:FlowPanel addStyleNames="col-sm-4">
												<m:ObidosReadonlyTextBox ui:field="rawEntropyTextBox"/>
											</g:FlowPanel>
											<g:FlowPanel addStyleNames="col-sm-4">
												<b:FormLabel ui:field='rawEntropyLabel' addStyleNames='{style.info_label}' HTML="{i18n.higerRawEntropyHint}" />
											</g:FlowPanel>
										 </m:ObidosRowBottom2px>

										<!--  entropy row with info -->
										<b:Row ui:field="entropyRow" visible="true">
											   <b:FormLabel ui:field="adjustedEntropyLabel" addStyleNames="col-sm-4" text="{i18n.adjustedEntropy}"/>
											<g:FlowPanel addStyleNames="col-sm-4">
												<b:InputGroup>
													<m:ObidosReadonlyTextBox ui:field="entropyTextBox"/>
													<b:InputGroupButton>
														<b:Button type="INFO" ui:field='entropyInfoButton' text="Info" title="{i18n.info}"/>
													</b:InputGroupButton>
												</b:InputGroup>
											</g:FlowPanel>
											<g:FlowPanel addStyleNames="col-sm-4">
												<b:FormLabel ui:field='adjustedEntropyLabelHint' addStyleNames='{style.info_label}' HTML="{i18n.higerAdjustedEntropyHint}" />
											</g:FlowPanel>
										</b:Row>

										<!--  horizontal separator -->
										<b:Row ui:field='bottomUhrRow2'>
											<g:FlowPanel addStyleNames="col-sm-offset-2 col-sm-8">
												<b:Row addStyleNames="{style.uhr}" />
											</g:FlowPanel>
										</b:Row>
                                    </b:Row>

                                    <!--  do not show cracking speed -->
									<m:ObidosRowTop2px visible="false">
   										<b:FormLabel for="crackignSpeedLabel" addStyleNames="col-sm-4" text="{i18n.crackingSpeed}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
										  <m:ObidosGuessesPerSecondTextBox ui:field="guessPerSecondTextBox" placeholder="TODO"/>
										</g:FlowPanel>
									</m:ObidosRowTop2px>
									<m:ObidosRowTop2px visible="false">
   										<b:FormLabel for="estimatedCrackingTimeLabel" addStyleNames="col-sm-4" text="{i18n.estimatedCrackingTime}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
										  <m:ObidosReadonlyTextBox ui:field="estimatedCrackingTimeTextBox" placeholder="TODO"/>
										</g:FlowPanel>
									</m:ObidosRowTop2px>

									<m:ObidosMessageRow ui:field="messageRow" />
									
                                    <!--  have I been pawned -->
									<m:ObidosRow ui:field='haveIbeenPawnedRow' bottomMargin="2px" visible="false">
									   <g:FlowPanel addStyleNames="col text-center">
											<b:Button type="DANGER" ui:field='hibpButton' text="{i18n.checkCompromisedList}" visible="true"/>
										</g:FlowPanel>
									</m:ObidosRow>
								</b:Form>
							</g:HTMLPanel>
						</b:PanelBody>
					</b:Panel>
				</b:Row>
		</b:Container>
	</g:HTMLPanel>
</ui:UiBinder>

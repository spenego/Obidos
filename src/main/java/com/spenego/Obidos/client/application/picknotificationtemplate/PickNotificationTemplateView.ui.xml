<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:b.gwt="urn:import:org.gwtbootstrap3.client.ui.gwt"
             xmlns:m="urn:import:com.spenego.Obidos.client.application.widgets"
             xmlns:select="urn:import:org.gwtbootstrap3.extras.select.client.ui"
             xmlns:d="urn:import:com.spenego.Obidos.client.ui">

<ui:with field='i18n' type='com.spenego.Obidos.client.i18n.ObidosMessages'/>
<ui:style gss="true">
.item-message-info{
    margin: 10px 0px;
    padding:12px;
    color: #00529B;
    background-color: #BDE5F8;
    box-shadow:1px 1px 3px #888;
}
.form-error-label{
    color: red;
}
.notif-ginfo {
    background-color:  #EEEEEE;
    border-color: #2F79B9;
}
.margin-fix {
    margin-top: 0 !important;
}
.notif-paragraph-font {
    font-size: 13px;    
}
.item-margin {
    margin: 5px;
}
.panel-header-bg {
    background-color:#222222 !important;
}

</ui:style>

<g:HTMLPanel ui:field="htmlPanel">
	<b:Container addStyleNames="col-sm-12">
		<b:Row>
		   <b:BlockQuote addStyleNames="{style.notif-ginfo}" ui:field='helpBlockQuote' visible="false">
				<b.html:Paragraph ui:field='newGroupInfoParagraph' addStyleNames='{style.notif-paragraph-font}' HTML="{i18n.pickNotificationTemplateHelp}"/>
			</b:BlockQuote>
				<b:Panel type="PRIMARY" ui:field="panel">
       				<m:ObidosPanelHeader ui:field="panelHeader" showBackButton="false" headerText="{i18n.pickNotificationTemplate}"/>
					<b:PanelBody>
						<g:HTMLPanel>
						<b:Form type="HORIZONTAL">

                                    <b:Row visible="false">
										<b:FormLabel addStyleNames="col-sm-4" HTML="{i18n.selectANotificationTemplate}"/>
										<!--  specify id as defined in 
										ObidosConstants.java. Therefore, be careful and do not change them!!
										because these ids means something to database.
										 -->
										<g:FlowPanel addStyleNames="col-sm-4">
										   <select:Select showTick="true" fixedMenuSize="5" ui:field="selectTemplate">
											   <select:Option b:id="171" text="{i18n.editAccountCreatedTemplate}"/>
										   </select:Select>
									   </g:FlowPanel>
									</b:Row>
									
									<b:Row>
										<b:FormLabel addStyleNames="col-sm-4" HTML="{i18n.selectANotificationTemplate}"/>
										<g:FlowPanel addStyleNames="col-sm-4">
									       <b:ListBox b:id="selectTemplateListBox" ui:field='selectTemplateListBox'>
									       </b:ListBox>
								       </g:FlowPanel>
										   <!--  the items are added programmatically in Presenter -->
										   <!--  Due to a bug in listbox, values can not be specified -->
										   <!--  with text or value, so we can not use i18n defined values in-line -->

									</b:Row>

									<b:FormGroup>
									   <m:ObidosMessageRow ui:field="messageRow"/>
									   <b:Row>
									       <m:ObidosButtonToolBar ui:field="buttonToolBarBottom">
        									<b:Button type="SUCCESS" ui:field='editButton'  icon="ARROW_RIGHT" iconPosition="RIGHT" text="{i18n.editButtonTitle}"/>
									       </m:ObidosButtonToolBar>
									   </b:Row>
									</b:FormGroup>
							</b:Form>
						</g:HTMLPanel>
					</b:PanelBody>
				</b:Panel>
		</b:Row>
	</b:Container>
</g:HTMLPanel>
</ui:UiBinder>

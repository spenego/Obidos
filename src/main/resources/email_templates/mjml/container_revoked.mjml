<mjml>
  <mj-head>
      <mj-include path="./attrs.mjml"/>
  </mj-head>

  <mj-body background-color="#fff">
    <mj-include path="./header.mjml"/>
    <mj-section background-color="#fff" full-width="full-width">
      <mj-column>
        <!-- hi -->
        <mj-text mj-class="text-large">
        {{hello}}
        </mj-text>

        <!-- html message-->
        <mj-text mj-class="text-normal">
          {{html_message}}
        </mj-text>

        <!-- contact-->
        <mj-text mj-class="text-normal-black">
          {{contact}}
        </mj-text>

        <!-- comment-->
        <mj-text mj-class="text-comment">
          {{comment}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="footer">
      <mj-column>
        <mj-text font-size="12px" color="#eee">
          {{footer}}
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

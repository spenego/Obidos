	<dependencyManagement>
		<dependencies>
			<!-- ensure all GWT deps use the same version (unless overridden) -->
			<dependency>
				<groupId>org.gwtproject</groupId>
				<artifactId>gwt</artifactId>
				<version>${gwt.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- | We're using gwtbootstrap3 snapshot | ref: https://github.com/gwtbootstrap3/gwtbootstrap3/wiki/Initial-Setup -->
	<repositories>
		<repository>
			<id>sonatype-nexus-snapshots</id>
			<url>https://oss.sonatype.org/content/repositories/snapshots</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<releases>
				<enabled>false</enabled>
			</releases>
		</repository>

	</repositories>

	<build>
		<outputDirectory>${webappDirectory}/WEB-INF/classes</outputDirectory>

		<resources>
			<resource>
				<directory>src/main/java</directory>
				<excludes>
					<exclude>**/*.java</exclude>
					<exclude>**/application/**</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>src/main/resources/</directory>
			</resource>
			<resource>
				<directory>src/main/resources/filtered</directory>
				<filtering>true</filtering>
			</resource>
		</resources>

		<plugins>

			<!-- I decided to use jackson to marshal/unmarshal YAML. jackson uses 
				snakeyaml under the hood. However it pulls snakeyaml 1.23 and snakeyaml-1.20-android 
				and android one was causing marshalling to fail, so I am excluding it for 
				now. Now I question the quality of jackson, I think I will remove this garbage 
				tomorrow and just use snakeyaml directly. Jun-28-2019 jackson is dumped, 
				using snamkeyaml 1.24 but keep the exclusion plugin just in case something 
				else does it- Jun 29, 2019 -->
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.3.2</version>
				<configuration>
					<packagingExcludes>
						WEB-INF/lib/*android*,
					</packagingExcludes>
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>

			<!-- buildnumber plugin http://www.mojohaus.org/buildnumber-maven-plugin/index.html -->
			<!-- May-06-2017 -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>buildnumber-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<id>buildnumber</id>
						<phase>validate</phase>
						<goals>
							<goal>create</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<format>{0,number}</format>
					<items>
						<item>buildNumber</item>
					</items>
					<doCheck>true</doCheck>
					<doUpdate>true</doUpdate>
					<revisionOnScmFailure>unknownbuild</revisionOnScmFailure>

				</configuration>
			</plugin>


			<plugin>
				<groupId>net.ltgt.gwt.maven</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>${tbroyer.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<moduleName>${gwt.module}</moduleName>
					<moduleShortName>${gwt.shortName}</moduleShortName>
					<skipModule>false</skipModule>
					<failOnError>true</failOnError>
					<sourceLevel>${gwt.sourceLevel}</sourceLevel>

					<codeserverArgs>
						<arg>-src</arg>
						<arg>${project.basedir}/src/main/java</arg>
					</codeserverArgs>

					<jvmArgs>
						<arg>--add-opens=java.base/java.lang=ALL-UNNAMED</arg>
						<arg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</arg>
					</jvmArgs>

					<compilerArgs>
						<arg>-XnooptimizeDataflow</arg>
					</compilerArgs>
					<optimize>8</optimize>
					<warDir>${project.build.directory}/${project.build.finalName}</warDir>
					<classpathScope>compile+runtime</classpathScope>
					<startupUrls>
						<startupUrl>index.html</startupUrl>
					</startupUrls>
				</configuration>
			</plugin>

			<!-- Bug #140 jetty for super dev mode -->
			<plugin>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-maven-plugin</artifactId>
				<version>9.4.53.v20231009</version>
				<configuration>
                    <httpConnector>
                        <port>8888</port>
                    </httpConnector>
					<scanIntervalSeconds>10</scanIntervalSeconds>
					<webApp>
						<contextPath>/</contextPath>
						<descriptor>${project.basedir}/src/main/webapp/WEB-INF/web-dev.xml</descriptor>
						<resourceBases>
							<resourceBase>${project.basedir}/target/Obidos-1.0.1</resourceBase>
						</resourceBases>
					</webApp>
				</configuration>
			</plugin>


			<!-- ref: http://stackoverflow.com/questions/18653947/how-to-compile-maven-project-with-xlint -->
			<!-- to find deprecated stuff, do this: mvn clean mvn -DcompilerArgument=-Xlint:deprecation 
				compile -->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<release>${java.release}</release>
					<compilerArgument>${compilerArgument}</compilerArgument>
				</configuration>
			</plugin>

			<!-- mvn exec:exec will run these jobs -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${exec-maven.version}</version>
				<configuration>
					<executable>mvn</executable>
					<arguments>
						<argument>clean</argument>
						<argument>install</argument>
						<argument>gwt:devmode</argument>
					</arguments>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.12.4</version>
				<configuration>
					<skipTests>false</skipTests>
                    <argLine>
                        --add-opens java.naming/com.sun.jndi.ldap=ALL-UNNAMED
                        --add-exports java.naming/com.sun.jndi.ldap=ALL-UNNAMED
                    </argLine>
				</configuration>
			</plugin>

			<!-- jar with only server side classes -->
			<!-- mvn jar:jar will create it -->
			<!-- needed for REST service -->
			<!-- May-17-2025 -->
			<!-- update: thin jar is not useul, we need -->
			<!-- far with all server side classes plus -->
			<!-- all external jars -->
			<!-- mk_fat_server_jar.sh creates the far jar -->
			<!-- which can be used in other projects -->
			<!-- for example, REST service -->
			<!-- <plugin> <groupId>org.apache.maven.plugins</groupId> <artifactId>maven-jar-plugin</artifactId> 
				<version>3.2.2</version> <executions> <execution> <id>create-server-jar</id> 
				<phase>package</phase> <goals> <goal>jar</goal> </goals> <configuration> 
				<classifier>server</classifier> <includes> <include>com/spenego/Obidos/server/**</include> 
				<include>com/spenego/Obidos/shared/**</include> </includes> </configuration> 
				</execution> </executions> </plugin> -->
		</plugins>
	</build>

